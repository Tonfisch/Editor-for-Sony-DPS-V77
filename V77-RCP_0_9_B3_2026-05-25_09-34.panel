        <luaMethod luaMethodName="SendMeSysex" luaMethodCode="SendMeSysex = function(--[[ CtrlrModulator --]] mod, --[[ number --]] value, --[[ number --]] source)&#13;&#10;&#13;&#10;&#9;if is_panel_ready() == true then&#13;&#10;&#9;&#9;local DevCode = string.format('F0 4C 0%.1x 15 01', MidiChannel) &#13;&#10;&#9;&#9;local syx = DevCode..' 71 02 01 f7'&#13;&#10;&#9;&#9;local message = syx&#13;&#10;&#13;&#10;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(message))&#13;&#10;&#9;&#9;os.execute(sleep(200))&#13;&#10;&#9;&#9;local syy = DevCode..' 40 02 01 f7'&#13;&#10;&#13;&#10;&#9;&#9;local message = syy&#13;&#10;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(message))&#13;&#10;&#9;end&#13;&#10;end"
