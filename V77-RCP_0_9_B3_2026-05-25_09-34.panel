      <luaMethodGroup name="unused" uuid="44c006917afd4a3089070a85b5bfdaec">
        <luaMethod luaMethodName="snd8BitVal" luaMethodCode="snd8BitVal = function(--[[ CtrlrModulator --]] mod, --[[ number --]] value, --[[ number --]] source)&#10;&#13;&#10;  &#13;&#10;&#13;&#10;&#9;if is_panel_ready() == true then&#13;&#10;&#9;&#9;local DevCode = string.format('F0 4C 0%.1x 15 01', MidiChannel)&#13;&#10;&#13;&#10;&#9;&#9;local v = string.format(&quot;%.2x&quot;, (tonumber(mod:getProperty(&quot;modulatorCustomIndexGroup&quot;))))&#13;&#10;&#9;&#9;local w = string.format(&quot;%.2x&quot;, (tonumber(mod:getProperty(&quot;modulatorCustomIndex&quot;))))&#13;&#10;&#9;&#9;local paramValue_1 = '00'&#13;&#10;&#9;&#9;local x = tonumber(mod:getValueMapped())&#13;&#10;&#9;&#9;local z = prefix:getValueMapped()&#13;&#10;--dump(z)&#13;&#10;&#9;&#9;local message = table.concat({DevCode, paramValue_1, v, w, nibbles2or4(x, 8), 'F7'}, ' ')&#13;&#10;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(message))&#13;&#10;&#9;end&#13;&#10;end"
                   luaMethodLinkedProperty="luaModulatorValueChange" luaMethodSource="0"
                   uuid="94ffacfff74046bf84662d44a29d151b" luaMethodValid="1"/>
        <luaMethod luaMethodName="combine4n" luaMethodCode="function combine4n(a, b) -- convert two 4 bit nibbles to a single integer&#13;&#10;&#13;&#10;    local m = bit.lshift(a, 4)&#13;&#10;    return m + b&#13;&#10;end &#13;&#10;"
                   luaMethodLinkedProperty="" luaMethodSource="0" uuid="df1fd2e64dbd48fba82349f143e99a80"
                   luaMethodValid="1"/>
        <luaMethod luaMethodName="nibbles" luaMethodCode="function nibbles(nib)&#9;&#9;&#9;&#9;-- convert integer into two 4 bit nibbles&#13;&#10;&#13;&#10;local input = BigInteger(tonumber(nib))&#13;&#10;local x = input:getBitRangeAsInt(4, 4)&#13;&#10;local y = input:getBitRangeAsInt(0, 4)&#13;&#10;local x = string.format(&quot;%.2x&quot;, (input:getBitRangeAsInt(4, 4)))&#13;&#10;local y = string.format(&quot;%.2x&quot;, (input:getBitRangeAsInt(0, 4)))&#13;&#10;&#13;&#10;return x..' '.. y&#13;&#10;end&#13;&#10;"
                   luaMethodLinkedProperty="" luaMethodSource="0" uuid="992a0e24494f4f84b9c055c9241e5a65"
                   luaMethodValid="1"/>
      </luaMethodGroup>
      <luaMethodGroup name="bruteforce" uuid="0bbd90423d9c4ffaa94d47c10de845e1">
        <luaMethod luaMethodName="countMe2" luaMethodCode="function countMe2(a,c)&#9;&#9;&#9;--&#9;&#9; to get the result:&#9;&#9;writeIntoFile(table.concat(fileContent, &quot;\n&quot;))&#13;&#10;fileContent = {}&#13;&#10;local counter=0&#13;&#10;&#13;&#10;local b = 0 -1&#13;&#10;local level = 0&#13;&#10;--local decrease=false&#13;&#10;local increase=a&#13;&#10;&#13;&#10;--&#9;if increase==true then &#13;&#10;--&#13;&#10;--&#9;&#9;repeat counter=counter+1&#13;&#10; --&#9;&#9;b = b +1&#13;&#10;--&#9;&#9;local message = table.concat({'F0 4C 00 15 01 21', string.format(&quot;%02x&quot;, c), string.format(&quot;%02x&quot;, b), 'F7'}, ' ') &#13;&#10;--&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(message))--&#9;'F0 4C 00 15 01 21&#13;&#10;--&#9;&#9;os.execute(sleep(50))&#13;&#10;--&#9;&#9;--dump(counter) &#13;&#10;--&#9;&#9;--dump(message)&#13;&#10;--&#9;&#9;until counter==255&#13;&#10;--&#9;&#9;return b&#13;&#10; --&#9;end&#9;&#13;&#10;&#13;&#10;&#13;&#10;--if increase==true then &#13;&#10;--&#13;&#10;--&#9;&#9;repeat counter=counter+1&#13;&#10;-- &#9;&#9;b = b +1&#13;&#10;--&#9;&#9;local message = table.concat({'F0 4C 00 15 01 01 05', string.format(&quot;%02x&quot;, b), '0a', 'F7'}, ' ') &#13;&#10;--&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(message))--&#9;'F0 4C 00 15 01 21&#13;&#10;--&#9;&#9;os.execute(sleep(50))&#13;&#10;&#9;&#9;--dump(counter) &#13;&#10;&#9;&#9;--dump(message)&#13;&#10;--&#9;&#9;until counter==255&#13;&#10;&#13;&#10;-- &#9;end&#9;&#13;&#10;&#13;&#10;--Parameter&#13;&#10;--&#9;if increase==true then --Zuordnung-FX zur FX-Map&#13;&#10;--&#13;&#10;--&#9;&#9;repeat counter=counter+1&#13;&#10;--&#9;&#9;b = b +1&#13;&#10;--&#9;&#9;local message = table.concat({'F0 4C 00 15 01 01', string.format(&quot;%02x&quot;, c), string.format(&quot;%02x&quot;, b), 'F7'}, ' ') &#13;&#10;--&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(message))--&#9;'F0 4C 00 15 01 21&#13;&#10;--&#9;&#9;os.execute(sleep(60))&#13;&#10;--&#9;&#9;--dump(counter) &#13;&#10;--&#9;&#9;--dump(message)&#13;&#10;--&#9;&#9;until counter==128&#13;&#10;--&#13;&#10;--&#9;end&#9;&#13;&#10;&#13;&#10;&#9;if increase==true then --Zuordnung-FX zur FX-Map&#13;&#10;&#13;&#10;&#9;&#9;repeat counter=counter+1&#9;&#9;--1&#13;&#10;&#9;&#9;c = c&#13;&#10;&#9;&#9;b = b +1&#13;&#10;&#9;&#9;local message = table.concat({'F0 4C 00 15 01 01', string.format(&quot;%02x&quot;, c), string.format(&quot;%02x&quot;, b), 'F7'}, ' ') &#13;&#10;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(message))&#13;&#10;&#9;&#9;os.execute(sleep(30))&#13;&#10;&#9;&#9;--dump(counter) &#13;&#10;&#9;&#9;--dump(message)&#13;&#10;&#9;&#9;until counter==128&#13;&#10;&#13;&#10;&#9;&#9;counter=0&#13;&#10;&#9;&#9;c = c+1&#13;&#10;&#9;&#9;b = 0 -1&#13;&#10;&#9;&#9;os.execute(sleep(1000))&#13;&#10;&#9;&#9;repeat counter=counter+1&#9;&#9;--2&#13;&#10;&#13;&#10;&#9;&#9;b = b +1&#13;&#10;&#9;&#9;local message = table.concat({'F0 4C 00 15 01 01', string.format(&quot;%02x&quot;, c), string.format(&quot;%02x&quot;, b), 'F7'}, ' ') &#13;&#10;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(message))&#13;&#10;&#9;&#9;os.execute(sleep(30))&#13;&#10;--dump(counter) &#13;&#10;--dump(message)&#13;&#10;&#9;&#9;until counter==128&#13;&#10;&#13;&#10;&#9;&#9;counter=0&#13;&#10;&#9;&#9;c = c+1&#13;&#10;&#9;&#9;b = 0 -1&#13;&#10;&#9;&#9;os.execute(sleep(1000))&#13;&#10;&#9;&#9;repeat counter=counter+1&#9;&#9;--3&#13;&#10;&#13;&#10;&#9;&#9;b = b +1&#13;&#10;&#9;&#9;local message = table.concat({'F0 4C 00 15 01 01', string.format(&quot;%02x&quot;, c), string.format(&quot;%02x&quot;, b), 'F7'}, ' ') &#13;&#10;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(message))&#13;&#10;&#9;&#9;os.execute(sleep(30))&#13;&#10;&#9;&#9;--dump(counter) &#13;&#10;&#9;&#9;--dump(message)&#13;&#10;&#9;&#9;until counter==128&#13;&#10;&#13;&#10;&#9;&#9;counter=0&#13;&#10;&#9;&#9;c = c+1&#13;&#10;&#9;&#9;b = 0 -1&#13;&#10;&#9;&#9;os.execute(sleep(1000))&#13;&#10;&#9;&#9;repeat counter=counter+1&#9;&#9;--4&#13;&#10;&#13;&#10;&#9;&#9;b = b +1&#13;&#10;&#9;&#9;local message = table.concat({'F0 4C 00 15 01 01', string.format(&quot;%02x&quot;, c), string.format(&quot;%02x&quot;, b), 'F7'}, ' ') &#13;&#10;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(message))&#13;&#10;&#9;&#9;os.execute(sleep(30))&#13;&#10;&#9;&#9;--dump(counter) &#13;&#10;&#9;&#9;--dump(message)&#13;&#10;&#9;&#9;until counter==128&#13;&#10;&#13;&#10;&#9;&#9;counter=0&#13;&#10;&#9;&#9;c = c+1&#13;&#10;&#9;&#9;b = 0 -1&#13;&#10;&#9;&#9;os.execute(sleep(1000))&#13;&#10;&#9;&#9;repeat counter=counter+1&#9;&#9;--5&#13;&#10;&#13;&#10;&#9;&#9;b = b +1&#13;&#10;&#9;&#9;local message = table.concat({'F0 4C 00 15 01 01', string.format(&quot;%02x&quot;, c), string.format(&quot;%02x&quot;, b), 'F7'}, ' ') &#13;&#10;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(message))&#13;&#10;&#9;&#9;os.execute(sleep(30))&#13;&#10;&#9;&#9;--dump(counter) &#13;&#10;&#9;&#9;--dump(message)&#13;&#10;&#9;&#9;until counter==128&#9;&#13;&#10;&#13;&#10;&#9;&#9;&#9;&#13;&#10;&#9;end&#9;&#13;&#10;&#13;&#10;&#13;&#10;end"
                   luaMethodLinkedProperty="" luaMethodSource="0" uuid="ccef56348fe54948b11c3d58e4835210"
                   luaMethodValid="1"/>
