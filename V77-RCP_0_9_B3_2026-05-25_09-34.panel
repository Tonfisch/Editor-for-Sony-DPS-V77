        <luaMethod luaMethodName="assignPresetLists" luaMethodCode="function assignPresetLists(singlePresetDumpRec)&#10;&#13;&#10;&#9;local Key1 = singlePresetDumpRec:getRange(6,1):toHexString(1);&#13;&#10;&#9;local Key2 = singlePresetDumpRec:getRange(7,1):toHexString(1);&#13;&#10;&#9;local bank = tonumber((Key1),16)&#13;&#10;&#9;local preset = tonumber((Key2),16)&#13;&#10;&#9;local PresetName = singlePresetDumpRec:getRange(0,40)&#13;&#10;&#13;&#10;&#9;if bank == 2 then&#9;--user1&#13;&#10;&#9;&#9;PsetLst_User1[preset]['Data'] = singlePresetDumpRec&#13;&#10;&#9;&#9;assignListName(PresetName, bank, preset)&#13;&#10;&#9;end&#13;&#10;&#9;if bank == 3 then&#9;--user2&#13;&#10;&#9;&#9;PsetLst_User2[preset]['Data'] = singlePresetDumpRec&#13;&#10;&#9;&#9;assignListName(PresetName, bank, preset)&#13;&#10;&#9;end&#10;end"
