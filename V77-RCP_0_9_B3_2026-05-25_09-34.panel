        <luaMethod luaMethodName="getDlydPset" luaMethodCode="function getDlydPset(bank, preset)&#13;&#10;&#10;&#9;local tableName = ''&#13;&#10;&#9;local listbox = ''&#13;&#10;&#13;&#10;&#9;if bank == 2 then&#13;&#10;&#9;&#9;tableName = PsetLst_User1&#13;&#10;&#9;&#9;listbox = 'PsetListBoxUser1'&#13;&#10;&#9;end&#13;&#10;&#9;if bank == 3 then&#13;&#10;&#9;&#9;tableName = PsetLst_User2&#13;&#10;&#9;&#9;listbox = 'PsetListBoxUser2'&#13;&#10;&#9;end&#13;&#10;&#9;bank = string.format(&quot;%.2x&quot;, bank)&#13;&#10;&#9;preset = string.format(&quot;%.2x&quot;, preset)&#13;&#10;&#10;&#9;local DevCode = string.format('F0 4C 0%.1x 15 01', MidiChannel)&#13;&#10;&#9;local paramValue_1 = 71&#13;&#10;&#9;local message = table.concat({DevCode, paramValue_1, bank, preset, 'F7'}, ' ') &#13;&#10;&#9;psetDumpRec = true&#13;&#10;&#9;Gt_Ps_Lst_Akt:setValueMapped(1, false, false)&#13;&#10;&#9;timer:setCallback(4, TimerCallback) &#13;&#10;&#9;timer:startTimer(4, 1300) &#13;&#10;&#10;&#9;timer:setCallback(18, function() panel:sendMidiMessageNow(CtrlrMidiMessage(message)) timer:stopTimer(18) end)&#13;&#10;&#9;timer:startTimer(18, 900)&#13;&#10;&#13;&#10;&#9;timer:setCallback(19, function() assignPsetListBox(tableName, listbox) deselAllListRows() timer:stopTimer(19) end)&#13;&#10;&#9;timer:startTimer(19, 1400)&#13;&#10;&#10;end&#13;&#10;&#13;&#10;"
                   luaMethodLinkedProperty="" luaMethodSource="0" uuid="5f727c4f3f4c470da0fb31a73fef15ff"
                   luaMethodValid="1"/>
      </luaMethodGroup>
      <luaMethodGroup name="presetman" uuid="f35a062932ba4ec3a810bd647f421308">
        <luaMethod luaMethodName="loadSelectetPreset" luaMethodCode="loadSelectetPreset = function(--[[ CtrlrModulator --]] mod, --[[ number --]] value, --[[ number --]] source)&#13;&#10;&#10;&#9;if is_panel_ready() == true then&#13;&#10;&#13;&#10;&#9;&#9;local DevCode = string.format('F0 4C 0%.1x 15 01', MidiChannel)&#9;&#13;&#10;&#9;&#9;local v = string.format(&quot;%.2x&quot;, (mod:getProperty(&quot;modulatorCustomIndexGroup&quot;)))&#13;&#10;--&#9;&#9;local w = string.format(&quot;%.2x&quot;, (tonumber(mod:getProperty(&quot;modulatorCustomIndex&quot;))))&#13;&#10;&#9;&#9;local name = mod:getProperty(&quot;modulatorCustomName&quot;)&#9;&#9;--ListBoxName&#13;&#10;&#9;&#9;local paramValue_1 = 71&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;--getDump&#13;&#10;&#9;&#9;local paramValue_2 = 40&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;--V77 load Preste..&#13;&#10;&#9;&#9;local l = panel:getListBox(name)&#13;&#10; &#9;&#9;psetListRow = (l:getLastRowSelected())+1&#13;&#10;&#9;&#9;local row = string.format(&quot;%.2x&quot;, psetListRow)&#13;&#10;&#13;&#10;&#9;&#9;if psetListRow ~= 0 then&#13;&#10;&#9;&#9;&#9;local message = table.concat({DevCode, paramValue_1, v, row, 'F7'}, ' ')   &#13;&#10;&#9;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(message))&#13;&#10;&#13;&#10;&#9;&#9;&#9;os.execute(sleep(200))&#13;&#10;&#9;&#9;&#9;local message = table.concat({DevCode, paramValue_2, v, row, 'F7'}, ' ')   &#13;&#10;&#9;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(message))&#13;&#10;&#9;&#9;&#9;deSelectListRows('PsetListBox1')&#13;&#10;&#9;&#9;&#9;deSelectListRows('PsetListBox2')&#13;&#10;&#9;&#9;&#9;deSelectListRows('PsetListBoxUser1')&#13;&#10;&#9;&#9;&#9;deSelectListRows('PsetListBoxUser2')&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;if psetListRow == 0 then&#9;&#9;&#13;&#10;&#9;&#9;&#9;assignInfoDisplay('please select the preset to load')&#13;&#10;&#9;&#9;end&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;"
                   luaMethodLinkedProperty="" luaMethodSource="0" uuid="207fcdbdff8a4df6a36f7e3b96cdea7f"
                   luaMethodValid="1"/>
        <luaMethod luaMethodName="recallPset" luaMethodCode="--&#10;-- Called when a modulator value changes&#10;-- @mod   http://ctrlr.org/api/class_ctrlr_modulator.html&#10;-- @value    new numeric value of the modulator&#10;--&#10;recallPset = function(--[[ CtrlrModulator --]] mod, --[[ number --]] value, --[[ number --]] source)&#10;&#10;&#9;&#9;local DevCode = string.format('F0 4C 0%.1x 15 01', MidiChannel)&#13;&#10;&#9;&#9;local v = string.format(&quot;%.2x&quot;, (tonumber(mod:getProperty(&quot;modulatorCustomIndexGroup&quot;))))&#13;&#10;&#9;&#9;local w = string.format(&quot;%.2x&quot;, (tonumber(mod:getProperty(&quot;modulatorCustomIndex&quot;))))&#13;&#10;&#9;&#9;local paramValue_1 = '40'&#13;&#10;&#9;&#9;local x = string.format(&quot;%.2x&quot;, tonumber(mod:getValueMapped()))&#13;&#10;&#13;&#10;&#9;&#9;local message = table.concat({DevCode, paramValue_1, '02', x, 'F7'}, ' ')&#13;&#10;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(message))&#13;&#10;end"
                   luaMethodLinkedProperty="luaModulatorValueChange" luaMethodSource="0"
                   uuid="a17a6be93b394699b221480e8feddda3" luaMethodValid="1"/>
        <luaMethod luaMethodName="getDataFromPsetList" luaMethodCode="function getDataFromPsetList(PsetLst,Nr)&#13;&#10;&#9;--local Nr = 1&#13;&#10;&#13;&#10;&#9;local PsetData = PsetLst[Nr]['Data']&#13;&#10;&#9;local Key1 = PsetData:getRange(6,1):toHexString(1)&#13;&#10;&#9;local Key2 = PsetData:getRange(7,1):toHexString(1)&#13;&#10;&#9;local bank = tonumber((Key1),16)&#13;&#10;&#9;local presetNum = tonumber((Key2),16)&#13;&#10;&#9;local unknownx = combNib(PsetData:getRange(8,2),8)&#13;&#10;&#9;local PresetIcon = combNib(PsetData:getRange(10,2),8)&#13;&#10;&#9;local PresetName = PsetData:getRange(12,28)&#13;&#10;&#9;local unknowny = combNib(PsetData:getRange(40,2),8)&#13;&#10;&#9;local unknownz = combNib(PsetData:getRange(42,2),8)&#13;&#10;&#9;local CHKSM = combNib(PsetData:getRange(44,2),16)&#13;&#10;&#13;&#10;&#13;&#10;&#9;local MixParam01 = combNib(PsetData:getRange(48,2),8)&#13;&#10;&#9;local MixParam02 = combNib(PsetData:getRange(50,2),8)&#13;&#10;&#9;local MixParam03 = combNib(PsetData:getRange(52,2),8)&#13;&#10;&#9;local MixParam04 = combNib(PsetData:getRange(54,2),8)&#13;&#10;&#9;local MixParam05 = combNib(PsetData:getRange(56,2),8)&#13;&#10;&#9;local MixParam06 = combNib(PsetData:getRange(58,2),8)&#13;&#10;&#9;local MixParam07 = combNib(PsetData:getRange(60,2),8)&#13;&#10;&#9;local MixParam08 = combNib(PsetData:getRange(62,2),8)&#13;&#10;&#9;local MixParam09 = combNib(PsetData:getRange(64,2),8)&#13;&#10;&#9;local MixParam10 = combNib(PsetData:getRange(66,2),8)&#13;&#10;&#9;local MixParam11 = combNib(PsetData:getRange(68,2),8)&#13;&#10;&#9;local MixParam12 = combNib(PsetData:getRange(70,2),8)&#13;&#10;&#13;&#10;&#13;&#10;&#9;local EqApara0 = combNib(PsetData:getRange(72,2),8)&#13;&#10;&#9;local EqApara1 = combNib(PsetData:getRange(74,2),8)&#13;&#10;&#9;local EqApara2 = combNib(PsetData:getRange(76,2),8)&#13;&#10;&#9;local EqApara3 = combNib(PsetData:getRange(78,2),8)&#13;&#10;&#9;local EqApara4 = combNib(PsetData:getRange(80,2),8)&#13;&#10;&#9;local EqApara