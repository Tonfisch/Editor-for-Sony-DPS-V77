        <luaMethod luaMethodName="ChVisButt" luaMethodCode="--&#10;-- Called when a modulator value changes&#10;-- @mod   http://ctrlr.org/api/class_ctrlr_modulator.html&#10;-- @value    new numeric value of the modulator&#10;--&#10;ChVisButt = function(--[[ CtrlrModulator --]] mod, --[[ number --]] value, --[[ number --]] source)&#13;&#10;&#13;&#10;&#9;if is_panel_ready() == true and source ~= 5 then&#13;&#10;&#9;&#9;if value == 0 then&#13;&#10;&#9;&#9;&#9;AddButt_Unvisible()&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;if value == 1 then&#13;&#10;&#9;&#9;&#9;AddButt_visible()&#13;&#10;&#9;&#9;end&#13;&#10;&#9;end&#10;end"
                   luaMethodLinkedProperty="luaModulatorValueChange" luaMethodSource="0"
                   uuid="19fea2f0ccbc4a738c29d8c45d670895" luaMethodValid="1"/>
      </luaMethodGroup>
      <luaMethod luaMethodName="receivedMidi" luaMethodCode="-- https://github.com/RomanKubiak/ctrlr/blob/master/Source/MIDI/CtrlrMidiMessage.h&#10;-- Called when a panel receives a midi message (does not need to match any modulator mask)&#10;-- @midi   CtrlrMidiMessage object&#10;&#13;&#10;--&#9;&#9; &#9;&#9;&#9;&#9;&#9;writeIntoFile(table.concat(fileContent, &quot;\n&quot;)) -- for get content to file&#13;&#10;vari = 0;&#13;&#10;fileContent = {};&#10;&#10;receivedMidi = function(midiMessage)&#13;&#10;&#9;class = midiMessage:getData():getRange(5,1):toHexString(1)&#13;&#10;&#9;local l = midiMessage:getData():getSize()&#13;&#10;&#9;local Key1 = midiMessage:getData():getRange(6,1):toHexString(1);&#13;&#10;&#9;local Key2 = midiMessage:getData():getRange(7,1):toHexString(1);&#13;&#10;&#9;&#13;&#10;&#9;if(class == &quot;24&quot;) then -- Algor. Info&#13;&#10;&#9;local stopper = midiMessage:getData():getRange(7,1):toHexString(1);&#13;&#10;&#9;&#9;if stopper ~= nil then  --stopper ~= 'f7'&#13;&#10;&#9;&#9;numberOfCharacters = (tonumber(l)) -9 -5&#9;&#13;&#10;&#9;&#9;&#9;local forLabel1 = midiMessage:getData():getRange(8,5):toHexString(1)&#13;&#10;&#9;&#9;&#9;local forLabel_ascii1 = translateHexToAscii(forLabel1)&#13;&#10;&#9;&#9;&#9;local forLabel2 = midiMessage:getData():getRange(14,(l -16)):toHexString(1)&#13;&#10;&#9;&#9;&#9;local forLabel_ascii2 = translateHexToAscii(forLabel2)&#13;&#10;&#9;&#9;&#9;local eintrag = Key1..' '..Key2..' '..forLabel_ascii1..' '..forLabel_ascii2&#13;&#10;&#9;&#9;&#9;table.insert(fileContent, eintrag)&#13;&#10;&#9;&#9;end&#13;&#10;&#9;end&#13;&#10;&#13;&#10;&#9;if(class == &quot;00&quot;) then -- Parameter Label Message&#9;&#9;&#9;&#9;&#9;&#9;&#9;--turn back &quot;oN&quot; after &quot;Count&quot;&#13;&#10;&#9;&#9;&#9;local FadVal = midiMessage:getData():getRange(5,7)--:toHexString(1)&#13;&#10;&#9;&#9;&#9;gatherSingFadToLst(FadVal)&#13;&#10;&#9;end&#13;&#10;&#13;&#10;&#9;if(class == &quot;20&quot;) then -- Parameter Name&#13;&#10;&#9;local stopper = midiMessage:getData():getRange(22,1):toHexString(1);&#13;&#10;&#9;&#9;if stopper ~= 'f7' and stopper ~= nil then&#13;&#10;&#9;&#9;numberOfCharacters = (tonumber(l)) -20 -8&#13;&#10;&#13;&#10;&#9;&#9;&#9;local forLabel2 = midiMessage:getData():getRange(26,numberOfCharacters):toHexString(1)&#13;&#10;&#9;&#9;&#9;local forLabel_ascii2 = translateHexToAscii(forLabel2)&#13;&#10;&#9;&#9;&#9;assignParaNameLong(forLabel_ascii2)&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;end&#13;&#10;&#9;&#13;&#10;&#9;if(class == '70') and l == 505 then&#9;&#9;&#9;--singlePresetDumpRec&#9;&#9;&#9;&#13;&#10;&#9;&#9;local PresetName = midiMessage:getData():getRange(0,40)&#13;&#10;&#9;&#9;assignPresetName(PresetName)&#13;&#10;&#9;&#9;local singlePresetDumpRec = midiMessage:getData()&#13;&#10;&#9;&#9;assignPresetVal(singlePresetDumpRec)&#13;&#10;&#9;&#9;assignPresetLists(singlePresetDumpRec)&#13;&#10;&#9;end&#13;&#10;&#13;&#10;&#9;if(class == '72') and l == 319 then&#9;&#9;&#9;--Systemdump&#13;&#10;&#9;&#9;local SystemDump = midiMessage:getData()&#13;&#10;&#9;&#9;assignSystemInfo(SystemDump)&#9;&#13;&#10;&#9;end&#10;end&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;translateHexToAscii = function(hex)&#13;&#10;&#9;-- dump(hex:getSize())&#13;&#10;&#9;asciiTable = {}&#13;&#10;&#9;for i, byte in ipairs(hexStringToTable(hex)) do&#13;&#10;&#9;&#9;table.insert(asciiTable, string.char(tonumber(byte, 16)))&#13;&#10;&#9;end&#13;&#10;&#9;return table.concat(asciiTable)&#13;&#10;end&#13;&#10;&#13;&#10;hexStringToTable = function(hexString)&#13;&#10;&#9;local singleBytes = {} -- leere liste, hier kommen einfach die hex-werte rein&#13;&#10;&#9;for i in string.gmatch(hexString, &quot;%w+&quot;) do -- bei leerzeichen trennen (matchen auf alles, das kein leerzeichen ist)&#13;&#10;&#9;&#9;table.insert(singleBytes, i) -- die einzelnen bytes zur liste hinzuf&#252;gen&#13;&#10;&#9;end&#13;&#10;&#9;return singleBytes&#13;&#10;end&#13;&#10;&#13;&#10;writeIntoFile = function(textToWrite)&#13;&#10;&#9;fileToWrite = utils.saveFileWindow(&#13;&#10;&#9;&#9;&quot;Save content as text&quot;,&#13;&#10;&#9;&#9;File.getSpecialLocation(File.userDocumentsDirectory), -- D:\&#13;&#10;&#9;&#9;&quot;*.txt&quot;,&#13;&#10;&#9;&#9;true&#13;&#10;&#9;&#9;&#13;&#10;&#9;)&#13;&#10;&#9;if fileToWrite:replaceWithText (textToWrite, false, false) == false then&#13;&#10;&#9;&#9;utils.warnWindow (&quot;File write&quot;, &quot;Failed to write data to file: &quot;..fileToWrite.getFullPathName())&#13;&#10;&#9;end&#13;&#10;end "
                 luaMethodLinkedProperty="luaPanelMidiReceived" luaMethodSource="0"
                 uuid="af35b6a79536401685056641108bb99f" luaMethodValid="1"/>
      <luaMethod luaMethodName="onMidChChange" luaMethodCode="--&#10;-- Called when a MIDI channel property for the panel changes&#10;--&#10;onMidChChange = function(--[[ number --]] channelType, --[[ number --]] newChannel)&#10;&#13;&#10;MidiChannel = newChannel-1&#13;&#10;&#13;&#10;end"
                 luaMethodLinkedProperty="luaPanelMidiChannelChanged" luaMethodSource="0"
                 uuid="da253eee5a1a4574b409ffc1c8cd39f2" luaMethodValid="1"/>
    </luaManagerMethods>
  </luaManager>
