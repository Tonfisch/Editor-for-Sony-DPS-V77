        <luaMethod luaMethodName="assignTimeFader" luaMethodCode="function assignTimeFader(Time, TimeFine, Disp, paraTyp, FxPara)&#10;&#9;&#9;--local Time = FxATime2 &#9;&#9;&#9;&#9;&#9;&#9;--Time/Rate&#13;&#10;&#9;&#9;--local TimeFine = FxATime2Fine&#9;&#9;&#9;&#9;--Fine&#13;&#10;&#9;&#9;--local Disp = FxATime2Disp&#9;&#9;&#9;&#9;&#9;--value-display&#13;&#10;&#9;&#9;--local paraTyp = ParaTypFxA2&#9;&#9;&#9;&#9;&#9;--shortcut for submitting stuff to component&#13;&#10;&#9;&#9;local y = tostring(FxPara, &quot;%W&quot;)&#9;&#9;&#9;--substring did not work with numbers...&#13;&#10;&#9;&#9;local z = FxPara&#9;&#9;&#9;&#9;&#9;&#9;&#9;--number-(value) also needed&#13;&#10;&#9;&#9;local var1 = 0&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;--reset var1, for later fillup&#13;&#10;&#9;&#9;local var2 = string.sub(y, -1)*1&#9;&#9;&#9;--get the last digit for the Fine-Fader&#13;&#10;&#9;&#9;if z &lt;=10-1 then&#9;&#9;&#9;&#9;&#9;&#9;&#9;--truncate the last digit, for the Rough-Fader&#13;&#10;&#9;&#9;&#9;var1 = 0&#13;&#10;&#9;&#9;elseif z &lt;=100-1 and z &gt;=10 then&#9;&#9;&#9;&#13;&#10;&#9;&#9;&#9;var1 = string.sub(y, 1, 1)*10&#13;&#10;&#9;&#9;elseif z &lt;=1000-1 and z &gt;=100 then&#9;&#9;&#9;&#13;&#10;&#9;&#9;&#9;var1 = string.sub(y, 1, 2)*10&#13;&#10;&#9;&#9;elseif z &lt;=10000 and z &gt;=1000 then &#9;&#9;&#9;&#13;&#10;&#9;&#9;&#9;var1 = string.sub(y, 1, 3)*10&#13;&#10;&#9;&#9;else end&#13;&#10;&#9;&#9;Time:getComponent():setProperty(&quot;uiFixedSliderContent&quot;, slidercontent[paraTyp[&quot;SubTypeIndex&quot;]], false)&#13;&#10;&#9;&#9;Time:getComponent():setProperty(&quot;componentVisibleName&quot;, paraTyp[&quot;shortName&quot;], false)&#13;&#10;&#9;&#9;TimeFine:getComponent():setProperty(&quot;componentVisibleName&quot;, paraTyp[&quot;shortName&quot;]..&quot;Fine&quot;, false)&#13;&#10;&#9;&#9;Time:getComponent():setVisible(true)&#13;&#10;&#9;&#9;TimeFine:getComponent():setVisible(true)&#13;&#10;&#9;&#9;Disp:getComponent():setVisible(true)&#13;&#10;&#9;&#9;Time:setValueMapped(var1, false, false)&#9;&#13;&#10;&#9;&#9;TimeFine:setValueMapped(var2, false, false)&#9;&#13;&#10;&#9;&#9;local var3 = var1+var2&#13;&#10;&#9;&#9;&#13;&#10;&#9;&#9;if var3 &lt;= 1000-1 then&#9;&#9;&#9;&#9;&#9;&#9;--generate the Parameterdisplayvalue&#13;&#10;&#9;&#9;&#9;LabelValue=var3*(1/10)&#13;&#10;&#9;&#9;&#9;Disp:getComponent():setPropertyString (&quot;uiLabelText&quot;, LabelValue..' '..'msec')&#13;&#10;&#9;&#9;elseif var3&lt;=1500-1 and var3&gt;=1000 then&#13;&#10;&#9;&#9;&#9;LabelValue=100+(var3-1000)*(1/5)&#13;&#10;&#9;&#9;&#9;Disp:getComponent():setPropertyString (&quot;uiLabelText&quot;, LabelValue..' '..'msec')&#13;&#10;&#9;&#9;elseif var3&lt;=2100-1 and var3&gt;=1500 then&#13;&#10;&#9;&#9;&#9;LabelValue=200+(var3-1500)*(1/2)&#13;&#10;&#9;&#9;&#9;Disp:getComponent():setPropertyString (&quot;uiLabelText&quot;, LabelValue..' '..'msec')&#13;&#10;&#9;&#9;elseif var3&lt;=2600-1 and var3&gt;=2100 then&#13;&#10;&#9;&#9;&#9;LabelValue=500+(var3-2100)*(1/1)&#13;&#10;&#9;&#9;&#9;Disp:getComponent():setPropertyString (&quot;uiLabelText&quot;, LabelValue..' '..'msec')&#13;&#10;&#9;&#9;elseif var3&lt;=2773 and var3&gt;=2600 then&#13;&#10;&#9;&#9;&#9;LabelValue=1000+(var3-2600)*(10)&#13;&#10;&#9;&#9;&#9;Disp:getComponent():setPropertyString (&quot;uiLabelText&quot;, LabelValue..' '..'msec')&#13;&#10;&#9;&#9;else end&#10;end"
                   luaMethodLinkedProperty="" luaMethodSource="0" uuid="101289f910b34bcb92f3d950e765ee90"
                   luaMethodValid="1"/>
        <luaMethod luaMethodName="assignMixedFader" luaMethodCode="function assignMixedFader(slider, paraTyp, FxPara)&#13;&#10;&#13;&#10; &#9;slider:getComponent():setProperty(&quot;uiFixedSliderContent&quot;, slidercontent[paraTyp[&quot;SubTypeIndex&quot;]], false)&#13;&#10;&#9;slider:setValueMapped(FxPara, false, true)&#13;&#10;&#9;slider:getComponent():setProperty(&quot;componentVisibleName&quot;, paraTyp[&quot;shortName&quot;], false)&#13;&#10; &#9;slider:getComponent():setVisible(true)&#13;&#10;end"
