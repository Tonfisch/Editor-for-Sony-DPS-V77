        <luaMethod luaMethodName="nibbles16Bit" luaMethodCode="&#9;&#9;&#9;&#9;-- convert integer into four 4 bit nibbles&#13;&#10;&#13;&#10;function nibbles16Bit(nibli16)&#13;&#10;&#13;&#10;&#9;local input = BigInteger()&#13;&#10;&#9;input = BigInteger(tonumber(nibli16))&#13;&#10;&#13;&#10;&#9;local a = string.format(&quot;%.2x&quot;, (input:getBitRangeAsInt(12, 4)))&#13;&#10;&#9;local b = string.format(&quot;%.2x&quot;, (input:getBitRangeAsInt(8, 4)))&#13;&#10;&#9;local c = string.format(&quot;%.2x&quot;, (input:getBitRangeAsInt(4, 4)))&#13;&#10;&#9;local d = string.format(&quot;%.2x&quot;, (input:getBitRangeAsInt(0, 4)))&#13;&#10;&#13;&#10;&#9;return a..' '..b..' '..c..' '..d&#13;&#10;end&#13;&#10;&#13;&#10;&#13;&#10;"
                   luaMethodLinkedProperty="" luaMethodSource="0" uuid="37cc4e78e79d45f099fc9f2076efa55f"
                   luaMethodValid="1"/>
