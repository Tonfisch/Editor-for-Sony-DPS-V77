9;end&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;if MixParam0 ~= 4 then&#13;&#10;&#9;&#9;&#9;combotext = combotext..combText1..combText2..combText3..combText4..combText5&#13;&#10;&#9;&#9;end&#13;&#10;&#13;&#10;&#9;&#9;if MixParam0 == 4 then&#13;&#10;&#9;&#9;&#9;combotext = combotext..combText1..combText2..combText5&#13;&#10;&#9;&#9;end&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#9;&#9;ParaTypEqA=AlgoTables[EqApara0]&#13;&#10;&#9;&#9;ParaTypFxA=AlgoTables[FxApara0]&#13;&#10;&#9;&#9;ParaTypEqB=AlgoTables[EqBpara0]&#13;&#10;&#9;&#9;ParaTypFxB=AlgoTables[FxBpara0]&#13;&#10;&#9;&#9;ParaTypMix=RtcAlgTbls[MixParam0]&#13;&#10;&#13;&#10;&#9;&#9;if ParaTypEqA ~= nil then&#13;&#10;&#9;&#9;&#9;for i = 1,29 do&#13;&#10;&#9;&#9;&#9;&#9;if ParaTypEqA[i][&quot;SubTypeIndex&quot;] ~= nil then&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;apcTxt1=apcTxt1..'EqA '..ParaTypEqA[i][&quot;shortName&quot;]..'='..(i+32)..'\n'&#13;&#10;&#9;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;end&#13;&#10;&#13;&#10;&#13;&#10;&#9;&#9;if ParaTypFxA ~= nil then&#13;&#10;&#9;&#9;&#9;for i = 1,29 do&#13;&#10;&#9;&#9;&#9;&#9;if ParaTypFxA[i][&quot;SubTypeIndex&quot;] ~= nil then&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;apcTxt2=apcTxt2..'FxA '..ParaTypFxA[i][&quot;shortName&quot;]..'='..(i+64)..'\n'&#13;&#10;&#9;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;end&#13;&#10;&#13;&#10;&#9;&#9;if ParaTypEqB ~= nil then&#13;&#10;&#9;&#9;&#9;for i = 1,29 do&#13;&#10;&#9;&#9;&#9;&#9;if ParaTypEqB[i][&quot;SubTypeIndex&quot;] ~= nil then&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;apcTxt3=apcTxt3..'EqB '..ParaTypEqB[i][&quot;shortName&quot;]..'='..(i+96)..'\n'&#13;&#10;&#9;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;end&#13;&#10;&#13;&#10;&#9;&#9;if ParaTypFxB ~= nil then&#13;&#10;&#9;&#9;&#9;for i = 1,29 do&#13;&#10;&#9;&#9;&#9;&#9;if ParaTypFxB[i][&quot;SubTypeIndex&quot;] ~= nil then&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;apcTxt4=apcTxt4..'FxB '..ParaTypFxB[i][&quot;shortName&quot;]..'='..(i+128)..'\n'&#13;&#10;&#9;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;end&#13;&#10;&#13;&#10;&#9;&#9;if ParaTypMix ~= nil then&#13;&#10;&#9;&#9;&#9;for i = 1,11 do&#13;&#10;&#9;&#9;&#9;&#9;if ParaTypMix[i][&quot;ShNm&quot;] ~= '' and ParaTypMix[i][&quot;ShNm&quot;] ~= nil then&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;apcTxt5=apcTxt5..'Mix '..ParaTypMix[i][&quot;ShNm&quot;]..'='..(i+160)..'\n'&#13;&#10;&#9;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;end&#13;&#10;&#13;&#10;&#9;&#9;if MixParam0 ~= 4 then&#13;&#10;&#9;&#9;&#9;ApcComboText = ApcComboText..apcTxt1..apcTxt2..apcTxt3..apcTxt4..apcTxt5&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;if MixParam0 == 4 then&#13;&#10;&#9;&#9;&#9;ApcComboText = ApcComboText..apcTxt1..apcTxt2..apcTxt5&#13;&#10;&#9;&#9;end&#13;&#10;&#13;&#10;&#13;&#10;--dump(ParaTypMix[6][&quot;ShNm&quot;])&#13;&#10;--dump(ApcComboText)&#13;&#10;&#9;&#9;Rtc1ComboParam:getComponent():setProperty(&quot;uiComboContent&quot; , combotext, false)&#13;&#10;&#9;&#9;Rtc2ComboParam:getComponent():setProperty(&quot;uiComboContent&quot; , combotext, false)&#13;&#10;&#9;&#9;Rtc3ComboParam:getComponent():setProperty(&quot;uiComboContent&quot; , combotext, false)&#13;&#10;&#9;&#9;Rtc4ComboParam:getComponent():setProperty(&quot;uiComboContent&quot; , combotext, false)&#13;&#10;&#9;&#9;Rtc5ComboParam:getComponent():setProperty(&quot;uiComboContent&quot; , combotext, false)&#13;&#10;&#9;&#9;Rtc6ComboParam:getComponent():setProperty(&quot;uiComboContent&quot; , combotext, false)&#13;&#10;&#13;&#10;&#9;&#9;Apc1ComboParam:getComponent():setProperty(&quot;uiComboContent&quot; , ApcComboText, false)&#13;&#10;&#9;&#9;Apc2ComboParam:getComponent():setProperty(&quot;uiComboContent&quot; , ApcComboText, false)&#13;&#10;&#9;&#9;Apc3ComboParam:getComponent():setProperty(&quot;uiComboContent&quot; , ApcComboText, false)&#13;&#10;&#9;&#9;Apc4ComboParam:getComponent():setProperty(&quot;uiComboContent&quot; , ApcComboText, false)&#13;&#10;&#9;&#9;Apc5ComboParam:getComponent():setProperty(&quot;uiComboContent&quot; , ApcComboText, false)&#13;&#10;&#9;&#9;Apc6ComboParam:getComponent():setProperty(&quot;uiComboContent&quot; , ApcComboText, false)&#13;&#10;&#13;&#10;&#13;&#10;&#9;&#9;Rtc1ComboParaMin:setValue(sixtnbNegOrPos(Rtc1ParMinVal), false, false)&#13;&#10;&#9;&#9;Rtc2ComboParaMin:setValue(sixtnbNegOrPos(Rtc2ParMinVal), false, false)&#13;&#10;&#9;&#9;Rtc3ComboParaMin:setValue(sixtnbNegOrPos(Rtc3ParMinVal), false, false)&#13;&#10;&#9;&#9;Rtc4ComboParaMin:setValue(sixtnbNegOrPos(Rtc4ParMinVal), false, false)&#13;&#10;&#9;&#9;Rtc5ComboParaMin:setValue(sixtnbNegOrPos(Rtc5ParMinVal), false, false)&#13;&#10;&#9;&#9;Rtc6ComboParaMin:setValue(sixtnbNegOrPos(Rtc6ParMinVal), false, false)&#13;&#10;&#9;&#9;&#13;&#10;&#9;&#9;Rtc1ComboParaMax:setValue(sixtnbNegOrPos(Rtc1ParMaxVal), false, false)&#13;&#10;&#9;&#9;Rtc2ComboParaMax:setValue(sixtnbNegOrPos(Rtc2ParMaxVal), false, false)&#13;&#10;&#9;&#9;Rtc3ComboParaMax:setValue(sixtnbNegOrPos(Rtc3ParMaxVal), false, false)&#13;&#10;&#9;&#9;Rtc4ComboParaMax:setValue(sixtnbNegOrPos(Rtc4ParMaxVal), false, false)&#13;&#10;&#9;&#9;Rtc5ComboParaMax:setValue(sixtnbNegOrPos(Rtc5ParMaxVal), false, false)&#13;&#10;&#9;&#9;Rtc6ComboParaMax:setValue(sixtnbNegOrPos(Rtc6ParMaxVal), false, false)&#13;&#10;&#13;&#10;&#9;&#9;Rtc1ComboSrc:setValueMapped(Rtc1SourceVal, false, false)&#13;&#10;&#9;&#9;Rtc2ComboSrc:setValueMapped(Rtc2SourceVal, false, false)&#13;&#10;&#9;&#9;Rtc3ComboSrc:setValueMapped(Rtc3SourceVal, false, false)&#13;&#10;&#9;&#9;Rtc4ComboSrc:setValueMapped(Rtc4SourceVal, false, false)&#13;&#10;&#9;&#9;Rtc5ComboSrc:setValueMapped(Rtc5SourceVal, false, false)&#13;&#10;&#9;&#9;Rtc6ComboSrc:setValueMapped(Rtc6SourceVal, false, false)&#13;&#10;&#9;&#9;&#13;&#10;&#9;&#9;Rtc1ComboSourceMin:setValueMapped(Rtc1scMinVal, false, false)&#13;&#10;&#9;&#9;Rtc2ComboSourceMin:setValueMapped(Rtc2scMinVal, false, false)&#13;&#10;&#9;&#9;Rtc3ComboSourceMin:setValueMapped(Rtc3scMinVal, false, false)&#13;&#10;&#9;&#9;Rtc4ComboSourceMin:setValueMapped(Rtc4scMinVal, false, false)&#13;&#10;&#9;&#9;Rtc5ComboSourceMin:setValueMapped(Rtc5scMinVal, false, false)&#13;&#10;&#9;&#9;Rtc6ComboSourceMin:setValueMapped(Rtc6scMinVal, false, false)&#13;&#10;&#9;&#9;&#13;&#10;&#9;&#9;Rtc1ComboSourceMax:setValueMapped(Rtc1scMaxVal, false, false)&#13;&#10;&#9;&#9;Rtc2ComboSourceMax:setValueMapped(Rtc2scMaxVal, false, false)&#13;&#10;&#9;&#9;Rtc3ComboSourceMax:setValueMapped(Rtc3scMaxVal, false, false)&#13;&#10;&#9;&#9;Rtc4ComboSourceMax:setValueMapped(Rtc4scMaxVal, false, false)&#13;&#10;&#9;&#9;Rtc5ComboSourceMax:setValueMapped(Rtc5scMaxVal, false, false)&#13;&#10;&#9;&#9;Rtc6ComboSourceMax:setValueMapped(Rtc6scMaxVal, false, false)&#13;&#10;&#13;&#10;&#9;&#9;timer:setCallback(15, TimerCallback)&#13;&#10;&#9;&#9;timer:startTimer(15, 100)&#13;&#10;&#13;&#10;--dump(MixParam0)&#13;&#10;&#13;&#10;&#9;&#9;if MixParam0 == 4 then&#13;&#10;&#9;&#9;&#9;if Apc1ParamVal &gt;= 96 and Apc1ParamVal &lt;= 160 then&#13;&#10;&#9;&#9;&#9;&#9;bol1 = false&#13;&#10;&#9;&#9;&#9;else bol1 = true&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;if Apc2ParamVal &gt;= 96 and Apc2ParamVal &lt;= 160 then&#13;&#10;&#9;&#9;&#9;&#9;bol2 = false&#13;&#10;&#9;&#9;&#9;else bol2 = true&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;if Apc3ParamVal &gt;= 96 and Apc3ParamVal &lt;= 160 then&#13;&#10;&#9;&#9;&#9;&#9;bol3 = false&#13;&#10;&#9;&#9;&#9;else bol3 = true&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;if Apc4ParamVal &gt;= 96 and Apc4ParamVal &lt;= 160 then&#13;&#10;&#9;&#9;&#9;&#9;bol4 = false&#13;&#10;&#9;&#9;&#9;else bol4 = true&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;if Apc5ParamVal &gt;= 96 and Apc5ParamVal &lt;= 160 then&#13;&#10;&#9;&#9;&#9;&#9;bol5 = false&#13;&#10;&#9;&#9;&#9;else bol5 = true&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;if Apc6ParamVal &gt;= 96 and Apc6ParamVal &lt;= 160 then&#13;&#10;&#9;&#9;&#9;&#9;bol6 = false&#13;&#10;&#9;&#9;&#9;else bol6 = true&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;if MixParam0 &lt;= 3 then&#9;&#9;&#13;&#10;&#9;&#9;&#9;bol1 = true&#13;&#10;&#9;&#9;&#9;bol2 = true&#13;&#10;&#9;&#9;&#9;bol3 = true&#13;&#10;&#9;&#9;&#9;bol4 = true&#13;&#10;&#9;&#9;&#9;bol5 = true&#13;&#10;&#9;&#9;&#9;bol6 = true&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;apcComboVisible(bol1, bol2, bol3, bol4, bol5, bol6)&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#9;&#9;if MixParam0 == 4 then&#13;&#10;&#9;&#9;&#9;if Rtc1ParamVal &gt;= 96 and Rtc1ParamVal &lt;= 160 then&#13;&#10;&#9;&#9;&#9;&#9;bol11 = false&#13;&#10;&#9;&#9;&#9;else bol11 = true&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;if Rtc2ParamVal &gt;= 96 and Rtc2ParamVal &lt;= 160 then&#13;&#10;&#9;&#9;&#9;&#9;bol12 = false&#13;&#10;&#9;&#9;&#9;else bol12 = true&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;if Rtc3ParamVal &gt;= 96 and Rtc3ParamVal &lt;= 160 then&#13;&#10;&#9;&#9;&#9;&#9;bol13 = false&#13;&#10;&#9;&#9;&#9;else bol13 = true&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;if Rtc4ParamVal &gt;= 96 and Rtc4ParamVal &lt;= 160 then&#13;&#10;&#9;&#9;&#9;&#9;bol14 = false&#13;&#10;&#9;&#9;&#9;else bol14 = true&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;if Rtc5ParamVal &gt;= 96 and Rtc5ParamVal &lt;= 160 then&#13;&#10;&#9;&#9;&#9;&#9;bol15 = false&#13;&#10;&#9;&#9;&#9;else bol15 = true&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;if Rtc6ParamVal &gt;= 96 and Rtc6ParamVal &lt;= 160 then&#13;&#10;&#9;&#9;&#9;&#9;bol16 = false&#13;&#10;&#9;&#9;&#9;else bol16 = true&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;if MixParam0 &lt;= 3 then&#9;&#9;&#13;&#10;&#9;&#9;&#9;bol11 = true&#13;&#10;&#9;&#9;&#9;bol12 = true&#13;&#10;&#9;&#9;&#9;bol13 = true&#13;&#10;&#9;&#9;&#9;bol14 = true&#13;&#10;&#9;&#9;&#9;bol15 = true&#13;&#10;&#9;&#9;&#9;bol16 = true&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;rtcComboVisible(bol11, bol12, bol13, bol14, bol15, bol16)&#13;&#10;end"
                   luaMethodLinkedProperty="" luaMethodSource="0" uuid="f7a4b45a908d4d50aa2bb7de21906491"
                   luaMethodValid="1"/>
        <luaMethod luaMethodName="assignMorphSettings" luaMethodCode="function assignMorphSettings()&#10;&#9;FxBFaderUnvisible()&#13;&#10;&#9;EqBFaderUnvisible()&#10;end"
