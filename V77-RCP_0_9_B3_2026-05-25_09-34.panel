                   luaMethodValid="1"/>
        <luaMethod luaMethodName="dumpTimer" luaMethodCode="function dumpTimer(bank, preset, newName)&#13;&#10;&#10;&#9;CallGatherDumpLists()&#10;&#9;timer:setCallback(17, function() extractDumpListsToHex(bank, preset, newName) timer:stopTimer(17) end)&#13;&#10;&#9;timer:startTimer(17, 400)&#13;&#10;end"
                   luaMethodLinkedProperty="" luaMethodSource="0" uuid="58d85f56bb414c74b9138dbe757c269f"
                   luaMethodValid="1"/>
      </luaMethodGroup>
