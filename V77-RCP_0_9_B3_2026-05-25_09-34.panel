        <luaMethod luaMethodName="renamePset_master" luaMethodCode="renamePset_master = function(--[[ CtrlrModulator --]] mod, --[[ number --]] value, --[[ number --]] source)&#13;&#10;&#13;&#10;&#13;&#10;&#9;if is_panel_ready() == true and psetDumpRec == false then&#13;&#10;&#13;&#10;&#9;&#9;local v = tonumber(mod:getProperty(&quot;modulatorCustomIndexGroup&quot;))&#13;&#10;&#9;&#9;local name = mod:getProperty(&quot;modulatorCustomName&quot;)&#9;&#9;--ListBoxName&#13;&#10;&#9;&#9;local l = panel:getListBox(name)&#13;&#10; &#9;&#9;local psetListRow = (l:getLastRowSelected())+1&#13;&#10;&#9;&#9;if psetListRow ~= 0 then&#13;&#10;&#13;&#10;&#9;&#9;&#9;local psetName2 = PsetLst_User1[psetListRow]['pName']&#13;&#10;&#9;&#9;&#9;local psetName3 = PsetLst_User2[psetListRow]['pName']&#13;&#10;&#9;&#9;&#9;local psetName = ''&#13;&#10; &#9;&#9;&#9;&#9;if v == 2 then&#13;&#10;&#9;&#9;&#9;&#9;psetName = psetName2&#13;&#10;&#9;&#9;&#9;end&#13;&#10; &#9;&#9;&#9;if v == 3 then&#13;&#10;&#9;&#9;&#9;&#9;psetName = psetName3&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#13;&#10;&#9;&#9;&#9;PRESETtOrENAME = psetListRow&#13;&#10;&#9;&#9;&#9;BANKtOrENAME = v&#13;&#10;&#13;&#10;&#9;&#9;&#9;modalWindow = AlertWindow(&quot;\n\nRename the Preset,\nup to 14 characters long.&quot;, &quot;&quot;, AlertWindow.NoIcon)&#13;&#10;&#9;&#9;&#9;modalWindow:addButton(&quot;Cancel&quot;, 0, KeyPress(KeyPress.escapeKey), KeyPress())&#13;&#10;&#9;&#9;&#9;modalWindow:addButton(&quot;    OK    &quot;, 1, KeyPress(KeyPress.returnKey), KeyPress())&#13;&#10;&#9;&#9;&#9;modalWindow:addTextEditor (&quot;renameTextEditor&quot;, (psetName), &quot;Rename As:&quot;, false)&#13;&#10;&#9;&#9;&#9;modalWindow:setModalHandler(renPsetCallback)&#13;&#10;&#13;&#10;&#9;&#9;&#9;modalWindow:runModalLoop()&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;if psetListRow == 0 then&#9;&#9;&#13;&#10;&#9;&#9;&#9;assignInfoDisplay('please select the preset to rename')&#13;&#10;&#9;&#9;end&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;"
                   luaMethodLinkedProperty="" luaMethodSource="0" uuid="5ff4b313a187478f93be8d9fc6a29b44"
                   luaMethodValid="1"/>
        <luaMethod luaMethodName="renPsetCallback" luaMethodCode="function renPsetCallback(ret, window)&#13;&#10;&#13;&#10;&#9;if is_panel_ready() == true then&#13;&#10;&#13;&#10;&#9;&#9;local Nr = PRESETtOrENAME&#13;&#10;&#9;&#9;local bla = {}&#13;&#10;&#13;&#10;&#9;&#9;if &#9;BANKtOrENAME == 2 then&#13;&#10;&#9;&#9;&#9;bla = PsetLst_User1[Nr]['Data']&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;if &#9;BANKtOrENAME == 3 then&#13;&#10;&#9;&#9;&#9;bla = PsetLst_User2[Nr]['Data']&#13;&#10;&#9;&#9;end&#13;&#10;&#13;&#10;&#9;&#9;local DevCode = string.format('F0 4C 0%.1x 15 01', MidiChannel)&#13;&#10;&#9;&#9;local parameter1 = '70'&#13;&#10;&#9;&#9;local Key1 = bla:getRange(6,1):toHexString(1)&#13;&#10;&#9;&#9;local Key2 = bla:getRange(7,1):toHexString(1)&#13;&#10;&#9;&#9;local bank = tonumber(bla:getRange(6,1))&#13;&#10;&#9;&#9;local presetNum = tonumber((Key2),16)&#13;&#10;&#9;&#9;local preNameData = bla:getRange(8,4):toHexString(1)&#13;&#10;&#9;&#9;local postNameData = bla:getRange(40,504-40):toHexString(1)&#13;&#10;&#9;&#9;local EOX = 'F7'&#13;&#10;&#13;&#10;&#9;&#9;modalWindow:setVisible (false)&#13;&#10;&#9;&#9;if ret == 1 then&#13;&#10;&#9;&#9;&#9;newName = modalWindow:getTextEditor(&quot;renameTextEditor&quot;):getText()&#13;&#10;&#9;&#9;&#9;newName = getPrstNm(setLenghtName(newName))&#13;&#10;&#13;&#10;&#9;&#9;&#9;local newNamedPset = DevCode..' '..parameter1..' '..Key1..' '..Key2..' '..preNameData..' '..newName..' '..postNameData..' '..EOX&#13;&#10;&#9;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(newNamedPset))&#13;&#10;&#13;&#10;&#9;&#9;&#9;getDlydPset(BANKtOrENAME, Nr)&#13;&#10;&#9;&#9;end&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;"
                   luaMethodLinkedProperty="" luaMethodSource="0" uuid="535bfb7ee907467c914a92e997a2992b"
                   luaMethodValid="1"/>
        <luaMethod luaMethodName="saveToSelPset" luaMethodCode="saveToSelPset = function(--[[ CtrlrModulator --]] mod, --[[ number --]] value, --[[ number --]] source)&#13;&#10;&#13;&#10;&#9;if is_panel_ready() == true and psetDumpRec == false then&#13;&#10;&#13;&#10;&#9;&#9;local v = tonumber(mod:getProperty(&quot;modulatorCustomIndexGroup&quot;))&#13;&#10;&#9;&#9;local name = mod:getProperty(&quot;modulatorCustomName&quot;)&#9;&#9;--ListBoxName&#13;&#10;&#9;&#9;local l = panel:getListBox(name)&#13;&#10; &#9;&#9;local psetListRow = (l:getLastRowSelected())+1&#13;&#10;&#13;&#10;&#9;&#9;if psetListRow ~= 0 then&#13;&#10;  &#9;&#9;&#9;dumpTimer(v, psetListRow)&#13;&#10;&#9;&#9;&#9;getDlydPset(v, psetListRow)&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;if psetListRow == 0 then&#9;&#9;&#13;&#10;&#9;&#9;&#9;assignInfoDisplay('please select the preset to store to')&#13;&#10;&#9;&#9;end&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;"
                   luaMethodLinkedProperty="" luaMethodSource="0" uuid="ad99b22e043c476a82d981b850d0e5b9"
                   luaMethodValid="1"/>
        <luaMethod luaMethodName="getCurrPrstNm" luaMethodCode="function getCurrPrstNm()&#13;&#10;&#10;&#9;local txt1 = PresetLabel:getComponent():getProperty(&quot;uiLabelText&quot;)&#13;&#10;&#9;local txtb&#13;&#10;&#9;local m = {}&#13;&#10;&#9;local t = ''&#13;&#10;&#9;local s = ''&#13;&#10;&#13;&#10;&#9;for  i = 1,#txt1 do&#13;&#10;&#9;&#9;txtb = string.byte(txt1, i)&#13;&#10;&#9;&#9;m[i] = nibbles2or4(txtb,8)&#10;&#9;end&#13;&#10;&#13;&#10;&#9;for i = 1,14 do&#9;&#13;&#10;&#9;&#9;s = m[i]&#9;&#13;&#10;&#9;&#9;t = t..s..' '&#13;&#10;&#9;end&#13;&#10;&#9;return t&#13;&#10;end"
                   luaMethodLinkedProperty="" luaMethodSource="0" uuid="d672187edd044b6082d7cf7544f84433"
                   luaMethodValid="1"/>
        <luaMethod luaMethodName="getPrstNm" luaMethodCode="function getPrstNm(txt1)&#10;&#13;&#10;&#9;local txtb&#13;&#10;&#9;local m = {}&#13;&#10;&#9;local t = ''&#13;&#10;&#9;local s = ''&#13;&#10;&#9;for  i = 1,#txt1 do&#13;&#10;&#9;&#9;txtb = string.byte(txt1, i)&#13;&#10;&#9;&#9;m[i] = nibbles2or4(txtb,8)&#10;&#9;end&#13;&#10;&#9;for i = 1,14 do&#9;&#13;&#10;&#9;&#9;s = m[i]&#9;&#13;&#10;&#9;&#9;t = t..s..' '&#13;&#10;&#9;end&#13;&#10;&#9;return t&#13;&#10;end"
                   luaMethodLinkedProperty="" luaMethodSource="0" uuid="7526c964ed3d4920a83a856d5edbf63b"
                   luaMethodValid="1"/>
      </luaMethodGroup>
      <luaMethodGroup name="System" uuid="0d21884eab564a438d35ac8575a197fe">
        <luaMethod luaMethodName="assignSystemInfo" luaMethodCode="function assignSystemInfo(SystemDump)&#13;&#10;&#13;&#10;--all values 8 bit (7bit),exept 16 bit for Pedal min/max values&#13;&#10;&#13;&#10;&#9;local mdChVal = SystemDump:getByte(6)&#13;&#10;&#9;local mdOmniVal = SystemDump:getByte(7)&#13;&#10;&#9;local mdThrughVal = SystemDump:getByte(8)&#13;&#10;&#9;local mdPChgVal = SystemDump:getByte(9)&#13;&#10;&#9;local mdCChgVal = SystemDump:getByte(10)&#13;&#10;&#9;local mdChPrVal = SystemDump:getByte(11)&#13;&#10;&#9;local mdBenderVal = SystemDump:getByte(12)&#13;&#10;&#9;local mappBankVal = SystemDump:getRange(13,256)&#13;&#10;&#13;&#10;&#9;for i=1,128 do&#13;&#10;&#9;&#9;k=i*2&#13;&#10;&#9;&#9;PatchTable[i][&quot;patchBank&quot;] = mappBankVal:getByte(k-2)&#13;&#10;&#13;&#10;&#9;&#9;PatchTable[i][&quot;patchPreset&quot;] = mappBankVal:getByte(k-1)&#13;&#10;&#9;end&#13;&#10;&#13;&#10;&#9;local gateThresholdVal = SystemDump:getByte(269)&#13;&#10;&#9;&#13;&#10;&#9;local gateAttackVal = SystemDump:getByte(270)&#13;&#10;&#9;local gateReleaseVal = SystemDump:getByte(271)&#13;&#10;&#9;local displayModeVal = SystemDump:getByte(272)&#13;&#10;&#9;local displayLCDVal = SystemDump:getByte(273)&#13;&#10;&#9;local bypassModeVal = SystemDump:getByte(274)&#13;&#10;&#9;local dryVal = SystemDump:getByte(275)&#13;&#10;&#9;local morphTimeVal = SystemDump:getByte(276)&#13;&#10;&#9;local morphCourveVal = SystemDump:getByte(277)&#13;&#10;&#9;local pedal1MinVal = combNib(SystemDump:getRange(278,4),16)&#13;&#10;&#13;&#10;&#13;&#10;&#9;local pedal1MaxVal = combNib(SystemDump:getRange(282,4),16)&#13;&#10;&#13;&#10;&#9;local pedal1TypeVal = SystemDump:getByte(286)&#13;&#10;&#9;local pedal1CourveVal = SystemDump:getByte(287)&#13;&#10;&#13;&#10;&#9;local pedal2MinVal = combNib(SystemDump:getRange(288,4),16)&#13;&#10;&#9;local pedal2MaxVal = combNib(SystemDump:getRange(292,4),16)&#13;&#10;&#9;local pedal2TypeVal = SystemDump:getByte(296)&#13;&#10;&#9;local pedal2CourveVal = SystemDump:getByte(297)&#13;&#10;&#9;local pedalrange = SystemDump:getRange(298,20)&#13;&#10;&#13;&#10;&#9;for i=1,10 do&#13;&#10;&#9;&#9;k=i*2&#13;&#10;&#9;&#9;PedalPatchTable[i][&quot;patchBank&quot;] = pedalrange:getByte(k-2)&#13;&#10;&#9;&#9;PedalPatchTable[i][&quot;patchPreset&quot;] = pedalrange:getByte(k-1)&#13;&#10;&#9;end&#13;&#10;&#9;&#13;&#10;&#9;GateAtkSlid:setValueMapped(gateAttackVal, false, false)&#13;&#10;&#9;GateRelSlid:setValueMapped(gateReleaseVal, false, false)&#13;&#10;&#9;GateThrSlid:setValueMapped(gateThresholdVal, false, false)&#13;&#10;&#9;mdChSlider:setValueMapped(mdChVal, false, false)&#13;&#10;&#9;mdOmniSlider:setValueMapped(mdOmniVal, false, false)&#13;&#10;&#9;mdThrughSlider:setValueMapped(mdThrughVal, false, false)&#13;&#10;&#9;mdPChgSlider:setValueMapped(mdPChgVal, false, false)&#13;&#10;&#9;mdCChgSlider:setValueMapped(mdCChgVal, false, false)&#13;&#10;&#9;mdChPrSlider:setValueMapped(mdChPrVal, false, false)&#13;&#10;&#9;mdBenderSlider:setValueMapped(mdBenderVal, false, false)&#13;&#10;&#9;displayModeSlider:setValueMapped(displayModeVal, false, false)&#13;&#10;&#9;displayLCDSlider:setValueMapped(displayLCDVal, false, false)&#13;&#10;&#9;bypassModeSlider:setValueMapped(bypassModeVal, false, false)&#13;&#10;&#9;drySlider:setValueMapped(dryVal, false, false)&#13;&#10;&#9;morphTimeSlider:setValueMapped(morphTimeVal, false, false)&#13;&#10;&#9;morphCourveSlider:setValueMapped(morphCourveVal, false, false)&#13;&#10;&#9;pedal1MinSlider:setValue(pedal1MinVal, false, false)&#13;&#10;&#9;pedal1MaxSlider:setValue(pedal1MaxVal, false, false)&#13;&#10;&#9;pedal1TypeSlider:setValueMapped(pedal1TypeVal, false, false)&#13;&#10;&#9;pedal1CourveSlider:setValueMapped(pedal1CourveVal, false, false)&#13;&#10;&#9;pedal2MinSlider:setValue(pedal2MinVal, false, false)&#13;&#10;&#9;pedal2MaxSlider:setValue(pedal2MaxVal, false, false)&#13;&#10;&#9;pedal2TypeSlider:setValueMapped(pedal2TypeVal, false, false)&#13;&#10;&#9;pedal2CourveSlider:setValueMapped(pedal2CourveVal, false, false)&#13;&#10;&#13;&#10;local v = ''&#13;&#10;&#9;for i=1,10 do&#13;&#10;&#9;&#9;v=v..'PedalPatch'..' '..i..': '..'Bank '..PedalPatchTable[i][&quot;patchBank&quot;]..'&#9;Preset '..PedalPatchTable[i][&quot;patchPreset&quot;]..'\n'&#13;&#10;&#9;end&#13;&#10;&#9;assignPatchListbox(PatchTable, 'PatchListbox', 128)&#13;&#10;&#9;assignPatchListbox(PedalPatchTable, 'PedalPatchListbox', 10)&#13;&#10;&#9;end"
                   luaMethodLinkedProperty="" luaMethodSource="0" uuid="d87f85d7ee794a94a552c69c8c4df5af"
                   luaMethodValid="1"/>
        <luaMethod luaMethodName="gatherSystemParas" luaMethodCode="function gatherSystemParas()&#13;&#10;&#13;&#10;&#9;if is_panel_ready() == true and psetDumpRec == false then&#13;&#10;&#9;&#9;local SystemDump = ''&#13;&#10;&#9;&#9;local o = 0&#13;&#10;&#9;&#9;local p = 0&#13;&#10;&#9;&#9;local q = 0&#13;&#10;&#9;&#9;local r = 0&#13;&#10;&#9;&#9;local DevCode = string.format('f0 4c 0%.1x 15 01 ', MidiChannel)&#13;&#10;&#9;&#9;local EOX = 'F7'&#13;&#10;&#9;&#9;local gateAttackVal = string.format(&quot;%.2x&quot;,(GateAtkSlid:getValueMapped()))&#13;&#10;&#9;&#9;local gateReleaseVal = string.format(&quot;%.2x&quot;,(GateRelSlid:getValueMapped()))&#13;&#10;&#9;&#9;local gateThresholdVal = string.format(&quot;%.2x&quot;,(GateThrSlid:getValueMapped()))&#13;&#10;&#9;&#9;local mdChVal = string.format(&quot;%.2x&quot;,(mdChSlider:getValueMapped()))&#13;&#10;&#9;&#9;local mdOmniVal = string.format(&quot;%.2x&quot;,(mdOmniSlider:getValueMapped()))&#13;&#10;&#9;&#9;local mdThrughVal = string.format(&quot;%.2x&quot;,(mdThrughSlider:getValueMapped()))&#13;&#10;&#9;&#9;local mdPChgVal = string.format(&quot;%.2x&quot;,(mdPChgSlider:getValueMapped()))&#13;&#10;&#9;&#9;local mdCChgVal = string.format(&quot;%.2x&quot;,(mdCChgSlider:getValueMapped()))&#13;&#10;&#9;&#9;local mdChPrVal = string.format(&quot;%.2x&quot;,(mdChPrSlider:getValueMapped()))&#13;&#10;&#9;&#9;local mdBenderVal = string.format(&quot;%.2x&quot;,(mdBenderSlider:getValueMapped()))&#13;&#10;&#9;&#9;local displayModeVal = string.format(&quot;%.2x&quot;,(displayModeSlider:getValueMapped()))&#13;&#10;&#9;&#9;local displayLCDVal = string.format(&quot;%.2x&quot;,(displayLCDSlider:getValueMapped()))&#13;&#10;&#9;&#9;local bypassModeVal = string.format(&quot;%.2x&quot;,(bypassModeSlider:getValueMapped()))&#13;&#10;&#9;&#9;local dryVal = string.format(&quot;%.2x&quot;,(drySlider:getValueMapped()))&#13;&#10;&#9;&#9;local morphTimeVal = string.format(&quot;%.2x&quot;,(morphTimeSlider:getValueMapped()))&#13;&#10;&#9;&#9;local morphCourveVal = string.format(&quot;%.2x&quot;,(morphCourveSlider:getValueMapped()))&#13;&#10;&#9;&#9;local pedal1MinVal = nibbles2or4(pedal1MinSlider:getValue(),16)&#13;&#10;&#9;&#9;local pedal1MaxVal = nibbles2or4(pedal1MaxSlider:getValue(),16)&#13;&#10;&#9;&#9;local pedal1TypeVal = string.format(&quot;%.2x&quot;,(pedal1TypeSlider:getValueMapped()))&#13;&#10;&#9;&#9;local pedal1CourveVal = string.format(&quot;%.2x&quot;,(pedal1CourveSlider:getValueMapped()))&#13;&#10;&#9;&#9;local pedal2MinVal = nibbles2or4(pedal2MinSlider:getValue(),16)&#13;&#10;&#9;&#9;local pedal2MaxVal = nibbles2or4(pedal2MaxSlider:getValue(),16)&#13;&#10;&#9;&#9;local pedal2TypeVal = string.format(&quot;%.2x&quot;,(pedal2TypeSlider:getValueMapped()))&#13;&#10;&#9;&#9;local pedal2CourveVal = string.format(&quot;%.2x&quot;,(pedal2CourveSlider:getValueMapped()))&#13;&#10;&#9;&#9;local pedalrange = ''&#13;&#10;&#9;&#9;local mappBankVal = ''&#13;&#10;&#9;&#13;&#10;&#9;&#9;for i=1,10 do&#13;&#10;&#9;&#9;&#9;o = PedalPatchTable[i][&quot;patchBank&quot;]--:getByte(k-2)&#13;&#10;&#9;&#9;&#9;p = PedalPatchTable[i][&quot;patchPreset&quot;]--:getByte(k-1)&#13;&#10;&#9;&#9;&#9;pedalrange = pedalrange..string.format(&quot;%.2x&quot;, o)..' '..string.format(&quot;%.2x&quot;, p)..' '&#13;&#10;&#9;&#9;end&#13;&#10;&#13;&#10;&#9;&#9;for i=1,128 do&#13;&#10;&#9;&#9;&#9;q = PatchTable[i][&quot;patchBank&quot;]&#13;&#10;&#9;&#9;&#9;r = PatchTable[i][&quot;patchPreset&quot;]&#13;&#10;&#9;&#9;&#9;mappBankVal = mappBankVal..string.format(&quot;%.2x&quot;, q)..' '..string.format(&quot;%.2x&quot;, r)..' '&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#13;&#10;&#9;&#9;SystemDump = SystemDump..DevCode..'72 '..mdChVal..' '..mdOmniVal..' '..mdThrughVal..' '..mdPChgVal..' '..mdCChgVal..' '..mdChPrVal..' '..mdBenderVal..' '..mappBankVal..gateThresholdVal..' '&#13;&#10;&#9;&#9;SystemDump = SystemDump..gateAttackVal..' '..gateReleaseVal..' '..displayModeVal..' '..displayLCDVal..' '..bypassModeVal..' '..dryVal..' '..morphTimeVal..' '..morphCourveVal..' '..pedal1MinVal..' '&#13;&#10;&#9;&#9;SystemDump = SystemDump..pedal1MaxVal..' '..pedal1TypeVal..' '..pedal1CourveVal..' '..pedal2MinVal..' '..pedal2MaxVal..' '..pedal2TypeVal..' '..pedal2CourveVal..' '..pedalrange..EOX&#13;&#10;&#13;&#10;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(SystemDump))&#13;&#10;&#9;end&#13;&#10;end"
