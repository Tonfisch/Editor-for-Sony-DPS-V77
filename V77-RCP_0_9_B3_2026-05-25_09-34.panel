        <luaMethod luaMethodName="svTempPatch" luaMethodCode="svTempPatch = function(--[[ CtrlrModulator --]] mod, --[[ number --]] value, --[[ number --]] source)&#10;&#13;&#10;&#9;if is_panel_ready() == true and psetDumpRec == false then&#13;&#10;&#13;&#10;&#9;local dataValid = psetNr:getComponent():getProperty(&quot;uiLabelText&quot;)&#13;&#10;&#13;&#10;&#9;&#9;local v = tonumber(mod:getProperty(&quot;modulatorCustomIndexGroup&quot;))&#13;&#10;&#9;&#9;local name = mod:getProperty(&quot;modulatorCustomName&quot;)&#9;&#9;--ListBoxName&#13;&#10;&#9;&#9;local l = panel:getListBox(name)&#13;&#10; &#9;&#9;local psetListRow = (l:getLastRowSelected())+1&#13;&#10;&#9;&#9;if dataValid ~= '00' then&#13;&#10;&#9;&#9;&#9;if v == 3 then&#13;&#10;&#9;&#9;&#9;&#9;if psetListRow ~= 0 then&#13;&#10;&#9;&#9;&#9;&#9;&#9;PatchTable[psetListRow][&quot;patchBank&quot;] = PatchBanKCombo:getValueMapped()&#13;&#10;&#9;&#9;&#9;&#9;&#9;PatchTable[psetListRow][&quot;patchPreset&quot;] = PatchPresetCombo:getValueMapped()&#13;&#10;&#9;&#9;&#9;&#9;&#9;assignPatchListbox(PatchTable, 'PatchListbox', 128)&#13;&#10;&#9;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;if v == 2 then&#13;&#10;&#9;&#9;&#9;&#9;if psetListRow ~= 0 then&#13;&#10;&#9;&#9;&#9;&#9;&#9;PedalPatchTable[psetListRow][&quot;patchBank&quot;] = PedalPatchBanKCombo:getValueMapped()&#13;&#10;&#9;&#9;&#9;&#9;&#9;PedalPatchTable[psetListRow][&quot;patchPreset&quot;] = PedalPatchPresetCombo:getValueMapped()&#13;&#10;&#9;&#9;&#9;&#9;&#9;assignPatchListbox(PedalPatchTable, 'PedalPatchListbox', 10)&#13;&#10;&#9;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;end&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;"
                   luaMethodLinkedProperty="luaModulatorValueChange" luaMethodSource="0"
                   uuid="e0dedf72d4174199b231d3daa0375766" luaMethodValid="1"/>
