      <luaMethodGroup name="chModSpecial" uuid="174537d1429e4013a3cd0b65d7be7e5c">
        <luaMethod luaMethodName="chMod3" luaMethodCode="chMod3 = function(--[[ CtrlrModulator --]] mod, --[[ number --]] value, --[[ number --]] source)&#13;&#10;&#13;&#10;&#9;if is_panel_ready() == true and source ~= 5 then&#13;&#10;&#9;&#9;local DevCode = string.format('F0 4C 0%.1x 15 01', MidiChannel)&#9;&#13;&#10;&#9;&#9;local v = string.format(&quot;%.2x&quot;, (mod:getProperty(&quot;modulatorCustomIndexGroup&quot;)))&#13;&#10;&#9;&#9;local w = string.format(&quot;%.2x&quot;, (tonumber(mod:getProperty(&quot;modulatorCustomIndex&quot;))))&#13;&#10;&#9;&#9;local name = mod:getProperty(&quot;modulatorCustomName&quot;)&#13;&#10;&#9;&#9;local LabelValue = 0&#13;&#10;&#9;&#9;local SendValue = 0&#13;&#10;&#9;&#9;local paramValue_1 = '00'&#13;&#10;&#9;&#9;local x = tonumber(mod:getValueMapped())&#13;&#10;&#13;&#10;&#9;&#9;panel:getComponent(name):setValue(0, false)&#13;&#10;&#9;&#9;local Test = mod:getProperty(&quot;name&quot;)&#13;&#10;&#9;&#9;local Disp = panel:getComponent(Test..'Disp')&#13;&#10;&#13;&#10;&#9;&#9;if x &lt;= 1000-1 then&#13;&#10;&#9;&#9;&#9;LabelValue=x*(1/10)&#13;&#10;&#9;&#9;&#9;SendValue = x&#13;&#10;&#9;&#9;&#9;local message = table.concat({DevCode, paramValue_1, v, w, nibbles2or4(SendValue, 16), 'F7'}, ' ')   &#13;&#10;&#9;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(message))&#13;&#10;--dump(message)&#13;&#10;&#9;&#9;&#9;Disp:setPropertyString (&quot;uiLabelText&quot;, LabelValue..' '..'msec')&#13;&#10;&#13;&#10;&#9;&#9;elseif x&lt;=1500-1 and x&gt;=1000 then&#13;&#10;&#9;&#9;&#9;LabelValue=100+(x-1000)*(1/5)&#13;&#10;&#9;&#9;&#9;SendValue = x&#13;&#10;&#9;&#9;&#9;local message = table.concat({DevCode, paramValue_1, v, w, nibbles2or4(SendValue, 16), 'F7'}, ' ')   &#13;&#10;&#9;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(message))&#13;&#10;&#9;&#9;&#9;Disp:setPropertyString (&quot;uiLabelText&quot;, LabelValue..' '..'msec')&#13;&#10;&#13;&#10;&#9;&#9;elseif x&lt;=2100-1 and x&gt;=1500 then&#13;&#10;&#9;&#9;&#9;LabelValue=200+(x-1500)*(1/2)&#13;&#10;&#9;&#9;&#9;SendValue = x&#13;&#10;&#9;&#9;&#9;local message = table.concat({DevCode, paramValue_1, v, w, nibbles2or4(SendValue, 16), 'F7'}, ' ')   &#13;&#10;&#9;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(message))&#13;&#10;&#9;&#9;&#9;Disp:setPropertyString (&quot;uiLabelText&quot;, LabelValue..' '..'msec')&#13;&#10;&#13;&#10;&#9;&#9;elseif x&lt;=2600-1 and x&gt;=2100 then&#13;&#10;&#9;&#9;&#9;LabelValue=500+(x-2100)*(1/1)&#13;&#10;&#9;&#9;&#9;SendValue = x&#13;&#10;&#9;&#9;&#9;local message = table.concat({DevCode, paramValue_1, v, w, nibbles2or4(SendValue, 16), 'F7'}, ' ')   &#13;&#10;&#9;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(message))&#13;&#10;&#9;&#9;&#9;Disp:setPropertyString (&quot;uiLabelText&quot;, LabelValue..' '..'msec')&#13;&#10;&#13;&#10;&#9;&#9;elseif x&lt;=4000 and x&gt;=2600 then&#13;&#10;&#9;&#9;&#9;LabelValue=1000+(x-2600)*(10)&#13;&#10;&#9;&#9;&#9;SendValue = x&#13;&#10;&#9;&#9;&#9;local message = table.concat({DevCode, paramValue_1, v, w, nibbles2or4(SendValue, 16), 'F7'}, ' ')   &#13;&#10;&#9;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(message))&#13;&#10;&#9;&#9;&#9;Disp:setPropertyString (&quot;uiLabelText&quot;, LabelValue..' '..'msec')&#13;&#10;&#9;&#9;elseif x&gt;=64536 and x&lt;=65535 then&#13;&#10;&#9;&#9;&#9;LabelValue=((65536-x)*-1)/10&#13;&#10;&#9;&#9;&#9;SendValue = x&#13;&#10;&#9;&#9;&#9;local message = table.concat({DevCode, paramValue_1, v, w, nibbles2or4(SendValue, 16), 'F7'}, ' ')   &#13;&#10;&#9;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(message))&#13;&#10;&#9;&#9;&#9;Disp:setPropertyString (&quot;uiLabelText&quot;, LabelValue..' '..'msec')&#13;&#10;&#9;&#9;else end&#13;&#10;&#9;end&#13;&#10;end"
                   luaMethodLinkedProperty="" luaMethodSource="0" uuid="10408ee78856403b81fec4971f67a14b"
                   luaMethodValid="1"/>
        <luaMethod luaMethodName="chMod3Fine" luaMethodCode="chMod3Fine = function(--[[ CtrlrModulator --]] mod, --[[ number --]] value, --[[ number --]] source)&#13;&#10;&#13;&#10;&#9;if is_panel_ready() == true and source ~= 5 then&#13;&#10;&#9;&#9;local DevCode = string.format('F0 4C 0%.1x 15 01', MidiChannel)&#13;&#10;&#9;&#9;local paramValue_1 = '00'&#13;&#10;&#9;&#9;local name = mod:getProperty(&quot;modulatorCustomName&quot;)&#13;&#10;&#9;&#9;local a = tonumber(mod:getValueMapped())&#13;&#10;&#9;&#9;local z = panel:getModulatorByName(name):getValueMapped()&#13;&#10;&#9;&#9;local v = string.format(&quot;%.2x&quot;, (tonumber(mod:getProperty(&quot;modulatorCustomIndexGroup&quot;))))&#13;&#10;&#9;&#9;local w = string.format(&quot;%.2x&quot;, (tonumber(mod:getProperty(&quot;modulatorCustomIndex&quot;))))&#13;&#10;&#9;&#9;local LabelValue = &quot;&quot;&#13;&#10;&#9;&#9;local Disp = panel:getComponent(name..'Disp')&#13;&#10;&#9;&#9;local x = z+a&#13;&#10;&#9;&#9;local y = z-a&#13;&#10;&#9;&#9;if z &lt;=12000 then&#13;&#10;&#9;&#9;&#9;local message = table.concat({DevCode, paramValue_1, v, w, nibbles2or4(x, 16), 'F7'}, ' ')&#13;&#10;&#9;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(message))&#13;&#10;&#9;&#13;&#10;&#9;&#9;&#9;if x &lt;= 1000-1 then&#13;&#10;&#9;&#9;&#9;&#9;LabelValue=x*(1/10)&#13;&#10;&#9;&#9;&#9;&#9;Disp:setPropertyString (&quot;uiLabelText&quot;, LabelValue..' '..'msec')&#13;&#10;&#9;&#9;&#9;elseif x&lt;=1500-1 and x&gt;=1000 then&#13;&#10;&#9;&#9;&#9;&#9;LabelValue=100+(x-1000)*(1/5)&#13;&#10;&#9;&#9;&#9;&#9;Disp:setPropertyString (&quot;uiLabelText&quot;, LabelValue..' '..'msec')&#13;&#10;&#9;&#9;&#9;elseif x&lt;=2100-1 and x&gt;=1500 then&#13;&#10;&#9;&#9;&#9;&#9;LabelValue=200+(x-1500)*(1/2)&#13;&#10;&#9;&#9;&#9;&#9;Disp:setPropertyString (&quot;uiLabelText&quot;, LabelValue..' '..'msec')&#13;&#10;&#9;&#9;&#9;elseif x&lt;=2600-1 and x&gt;=2100 then&#13;&#10;&#9;&#9;&#9;&#9;LabelValue=500+(x-2100)*(1/1)&#13;&#10;&#9;&#9;&#9;&#9;Disp:setPropertyString (&quot;uiLabelText&quot;, LabelValue..' '..'msec')&#13;&#10;&#9;&#9;&#9;elseif x&lt;=2773 and x&gt;=2600 then&#13;&#10;&#9;&#9;&#9;&#9;LabelValue=1000+(x-2600)*(10)&#13;&#10;&#9;&#9;&#9;&#9;Disp:setPropertyString (&quot;uiLabelText&quot;, LabelValue..' '..'msec')&#13;&#10;&#9;&#9;&#9;else end&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;if z &gt;=64000 then&#13;&#10;&#9;&#9;&#9;local message = table.concat({DevCode, paramValue_1, v, w, nibbles2or4(y, 16), 'F7'}, ' ')&#13;&#10;&#9;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(message))&#13;&#10;&#13;&#10;&#9;&#9;&#9;LabelValue=((-65536+y))*(1/10)&#13;&#10;&#9;&#9;&#9;Disp:setPropertyString (&quot;uiLabelText&quot;, LabelValue..' '..'msec')&#13;&#10;&#9;&#9;end&#13;&#10;&#9;end&#13;&#10;end"
                   luaMethodLinkedProperty="" luaMethodSource="0" uuid="b37a9bc560a34407b9bd4f9bf140c24a"
                   luaMethodValid="1"/>
