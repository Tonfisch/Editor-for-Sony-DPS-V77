                   luaMethodValid="1"/>
        <luaMethod luaMethodName="start_bPanel_Timer" luaMethodCode="function start_bPanel_Timer()&#13;&#10;&#13;&#10;os.execute(sleep(200))&#13;&#10;&#13;&#10;bPanelTimedOut = 1&#13;&#10;&#13;&#10;end"
                   luaMethodLinkedProperty="" luaMethodSource="0" uuid="5fce131b761147ec84fe83ce5f165081"
                   luaMethodValid="1"/>
        <luaMethod luaMethodName="is_panel_ready" luaMethodCode="function is_panel_ready()&#13;&#10;&#13;&#10;&#9;if panel:getBootstrapState() == false and bPanelTimedOut == 1&#13;&#10;&#13;&#10;&#9;then return (true)&#13;&#10;&#9;else return (false)&#13;&#10;&#13;&#10;&#9;end&#13;&#10;end"
                   luaMethodLinkedProperty="" luaMethodSource="0" uuid="acd1f65476ef4f71a1627a573d7b913c"
                   luaMethodValid="1"/>
        <luaMethod luaMethodName="before_panel_load" luaMethodCode="function before_panel_load()&#13;&#10;&#13;&#10;-- sets a variable 'bPanelTimedOut' to 0 which only gets set to 1 when the 'start_timer' modulator&#13;&#10;-- on the System Tab triggers it's 'Start_bPanel_Timer' script which runs for 200mS&#13;&#10;&#13;&#10;bPanelTimedOut = 0&#13;&#10;&#13;&#10;-- Defines the variable used to stop any Patch Saving occuring if no Patch Data has been loaded to Panel first&#13;&#10;&#13;&#10;panel_data_loaded = 0&#13;&#10;&#13;&#10;-- mutes any MIDI Out from the Panel&#13;&#10;&#13;&#10;panel:setPropertyInt(&quot;panelMidiPauseOut&quot;, 1)&#13;&#10;&#13;&#10;end"
                   luaMethodLinkedProperty="" luaMethodSource="0" uuid="acc47b97450a46289217cecf6ecdd8e1"
                   luaMethodValid="1"/>
      </luaMethodGroup>
      <luaMethodGroup name="requests" uuid="98964dffc83345f197271522e19129d6">
        <luaMethod luaMethodName="reqSysDmp" luaMethodCode="reqSysDmp = function(--[[ CtrlrModulator --]] mod, --[[ number --]] value, --[[ number --]] source)&#13;&#10;&#13;&#10;&#9;local delay = 80&#13;&#10;&#9;if is_panel_ready() == true then&#13;&#10;&#9;&#9;local DevCode = string.format('F0 4C 0%.1x 15 01', MidiChannel)&#9;&#9;&#13;&#10;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(string.format(DevCode..' 10 0a 00 f7')))&#13;&#10;&#13;&#10;&#9;&#9;os.execute(sleep(delay))&#13;&#10;&#13;&#10;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(string.format(DevCode..' 10 0a 00 f7')))&#13;&#10;&#13;&#10;&#9;&#9;os.execute(sleep(delay))&#13;&#10;&#13;&#10;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(string.format(DevCode..' 10 0a 00 f7')))&#13;&#10;&#13;&#10;&#9;&#9;os.execute(sleep(delay))&#13;&#10;&#13;&#10;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(string.format(DevCode..' 10 0a 00 f7')))&#13;&#10;&#13;&#10;&#9;&#9;os.execute(sleep(delay))&#13;&#10;&#13;&#10;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(string.format(DevCode..' 10 10 00 f7')))&#13;&#10;&#13;&#10;&#9;&#9;os.execute(sleep(delay))&#13;&#10;&#13;&#10;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(string.format(DevCode..' 10 07 00 f7')))&#13;&#10;&#13;&#10;&#9;&#9;os.execute(sleep(delay))&#13;&#10;&#13;&#10;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(string.format(DevCode..' 10 08 00 f7')))&#13;&#10;&#13;&#10;&#9;&#9;os.execute(sleep(delay))&#13;&#10;&#13;&#10;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(string.format(DevCode..' 10 1d 00 f7')))&#13;&#10;&#13;&#10;&#9;&#9;os.execute(sleep(delay))&#13;&#10;&#13;&#10;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(string.format(DevCode..' 10 1d 00 f7')))&#13;&#10;&#13;&#10;&#9;&#9;os.execute(sleep(delay))&#13;&#10;&#13;&#10;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(string.format(DevCode..' 10 1d 00 f7')))&#13;&#10;&#13;&#10;&#9;&#9;os.execute(sleep(delay))&#13;&#10;&#13;&#10;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(string.format(DevCode..' 10 09 00 f7')))&#13;&#10;&#13;&#10;&#9;&#9;os.execute(sleep(delay))&#13;&#10;&#13;&#10;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(string.format(DevCode..' 10 0a 00 f7')))&#13;&#10;&#13;&#10;&#9;&#9;os.execute(sleep(delay))&#13;&#10;&#13;&#10;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(string.format(DevCode..' 10 0a 00 f7')))&#13;&#10;&#13;&#10;&#9;&#9;os.execute(sleep(delay))&#13;&#10;&#13;&#10;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(string.format(DevCode..' 10 0a 00 f7')))&#13;&#10;&#13;&#10;&#9;&#9;os.execute(sleep(delay))&#13;&#10;&#13;&#10;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(string.format(DevCode..' 10 0a 00 f7')))&#10;&#9;end&#10;end"
                   luaMethodLinkedProperty="luaModulatorValueChange" luaMethodSource="0"
                   uuid="d8e79a03e80a4450898ce08bad730c99" luaMethodValid="1"/>
        <luaMethod luaMethodName="getAllUserPresetDumps" luaMethodCode="getAllUserPresetDumps = function(--[[ CtrlrModulator --]] mod, --[[ number --]] value, --[[ number --]] source)&#13;&#10;&#13;&#10;&#9;if is_panel_ready() == true and psetDumpRec == false then&#13;&#10;&#9;&#9;local DevCode = string.format('F0 4C 0%.1x 15 01', MidiChannel)&#13;&#10;&#9;&#9;psetDumpRec = true&#13;&#10;&#9;&#9;Gt_Ps_Lst_Akt:setValueMapped(1, false, false)&#13;&#10;&#9;&#9;timer:setCallback(4, TimerCallback) -- TimerId 4&#13;&#10;&#9;&#9;timer:startTimer(4, 40000) -- Timer Id &#13;&#10;&#13;&#10;&#9;&#9;iCounter = 1&#13;&#10;&#9;&#9;timer:setCallback(13, TimerCallback) -- TimerId 2&#13;&#10;&#9;&#9;timer:startTimer(13, 100) -- Timer Id 13 100ms&#10;&#9;end&#10;end&#13;&#10;"
                   luaMethodLinkedProperty="luaModulatorValueChange" luaMethodSource="0"
                   uuid="a761f859a00d41baacd06b577a84cc19" luaMethodValid="1"/>
        <luaMethod luaMethodName="getSingleValues" luaMethodCode="function getSingleValues(block)&#13;&#10;&#13;&#10;&#10;&#9;if is_panel_ready() == true then&#13;&#10;&#9;&#9;local DevCode = string.format('F0 4C 0%.1x 15 01', MidiChannel)&#9;&#13;&#10;&#9;&#9;local u = string.format(&quot;%.2x&quot;,block)&#13;&#10;&#9;&#9;for i=1,30 do&#13;&#10;&#9;&#9;&#9;v = string.format(&quot;%.2x&quot;,i-1)&#13;&#10;&#9;&#9;&#9;local message = table.concat({DevCode, '01', u, v, 'F7'}, ' ')&#13;&#10;--dump(message)&#13;&#10;&#9;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(message))&#9;&#13;&#10;&#9;&#9;end&#13;&#10;&#9;end&#10;end"
                   luaMethodLinkedProperty="" luaMethodSource="0" uuid="618935380b574475907a1d2e3eac476b"
                   luaMethodValid="1"/>
        <luaMethod luaMethodName="getParaLongName" luaMethodCode="function getParaLongName(v, w)&#13;&#10;&#9;local DevCode = string.format('F0 4C 0%.1x 15 01', MidiChannel)&#9;&#13;&#10;&#13;&#10;&#9;if v == 1 then&#13;&#10;&#9;&#9;local a = string.format(&quot;%.2x&quot;, (tonumber(EqAtypeCombo:getValueMapped())))&#13;&#10;&#9;&#9;local message = table.concat({DevCode, '21', a, w, 'F7'}, ' ')&#13;&#10;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(message))&#13;&#10;&#9;end&#13;&#10;&#9;if v == 2 then&#13;&#10;&#9;&#9;local a = string.format(&quot;%.2x&quot;, (tonumber(FxAdisplay:getValueMapped())))&#13;&#10;&#9;&#9;local message = table.concat({DevCode, '21', a, w, 'F7'}, ' ')&#13;&#10;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(message))&#13;&#10;&#9;end&#13;&#10;&#9;if v == 3 then&#13;&#10;&#9;&#9;local a = string.format(&quot;%.2x&quot;, (tonumber(EqBtypeCombo:getValueMapped())))&#13;&#10;&#9;&#9;local message = table.concat({DevCode, '21', a, w, 'F7'}, ' ')&#13;&#10;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(message))&#13;&#10;&#9;end&#13;&#10;&#9;if v == 4 then&#13;&#10;&#9;&#9;local a = string.format(&quot;%.2x&quot;, (tonumber(FxBdisplay:getValueMapped())))&#13;&#10;&#9;&#9;local message = table.concat({DevCode, '21', a, w, 'F7'}, ' ')&#13;&#10;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(message))&#13;&#10;&#9;end&#13;&#10;&#9;if v == 5 then&#13;&#10;&#9;&#9;local a = string.format(&quot;%.2x&quot;, (tonumber(MixStructCombo:getValueMapped())))&#13;&#10;&#9;&#9;local message = table.concat({DevCode, '21', a, w, 'F7'}, ' ')&#13;&#10;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(message))&#13;&#10;&#9;end &#13;&#10;&#13;&#10;&#10;end"
                   luaMethodLinkedProperty="" luaMethodSource="0" uuid="796f77446ae643b1a1f3693aaf330fe3"
                   luaMethodValid="1"/>
        <luaMethod luaMethodName="mouseEnterParaFxA" luaMethodCode="--&#10;-- Called when the mouse moves over a component&#10;--&#10;&#10;mouseEnterParaFxA = function(--[[ CtrlrComponent --]] comp, --[[ MouseEvent --]] event)&#13;&#10;&#13;&#10;&#9;if is_panel_ready() == true and psetDumpRec == false then&#13;&#10;&#13;&#10;&#9;&#9;if free == 1 then&#13;&#10;&#13;&#10;&#9;&#9;&#9;local name = L(comp:getOwner():getName())&#13;&#10;&#9;&#9;&#9;local DevCode = string.format('F0 4C 0%.1x 15 01', MidiChannel)&#9;&#13;&#10;&#13;&#10;&#9;&#9;&#9;local v = tonumber(panel:getModulatorByName(name):getProperty(&quot;modulatorCustomIndexGroup&quot;))&#10;&#9;&#13;&#10;&#9;&#9;&#9;local w = string.format(&quot;%.2x&quot;, (tonumber(panel:getModulatorByName(name):getProperty(&quot;modulatorCustomIndex&quot;))))&#13;&#10;&#9;&#9;&#9;getParaLongName(v, w)&#13;&#10;&#9;&#9;end&#13;&#10;&#9;end&#10;end"
                   luaMethodLinkedProperty="componentLuaMouseMoved" luaMethodSource="0"
                   uuid="acbec0d4a84d48898b3e52219725e017" luaMethodValid="1"/>
        <luaMethod luaMethodName="getUser1PresetDumps" luaMethodCode="getUser1PresetDumps = function(--[[ CtrlrModulator --]] mod, --[[ number --]] value, --[[ number --]] source)&#13;&#10;&#13;&#10;&#9;if is_panel_ready() == true and psetDumpRec == false then&#13;&#10;&#9;&#9;local DevCode = string.format('F0 4C 0%.1x 15 01', MidiChannel)&#13;&#10;&#9;&#9;psetDumpRec = true&#13;&#10;&#9;&#9;Gt_Ps_Lst_Akt:setValueMapped(1, false, false)&#13;&#10;&#9;&#9;timer:setCallback(4, TimerCallback) &#13;&#10;&#9;&#9;timer:startTimer(4, 20000) &#13;&#10;&#13;&#10;&#9;&#9;iCounter = 1&#13;&#10;&#9;&#9;timer:setCallback(20, TimerCallback)&#13;&#10;&#9;&#9;timer:startTimer(20, 100) &#10;&#9;end&#10;end&#13;&#10;"
                   luaMethodLinkedProperty="" luaMethodSource="0" uuid="7c2c142b8c4147aba98b1fdba13e21cc"
                   luaMethodValid="1"/>
        <luaMethod luaMethodName="getUser2PresetDumps" luaMethodCode="getUser2PresetDumps = function(--[[ CtrlrModulator --]] mod, --[[ number --]] value, --[[ number --]] source)&#13;&#10;&#13;&#10;&#9;if is_panel_ready() == true and psetDumpRec == false then&#13;&#10;&#9;&#9;local DevCode = string.format('F0 4C 0%.1x 15 01', MidiChannel)&#13;&#10;&#9;&#9;psetDumpRec = true&#13;&#10;&#9;&#9;Gt_Ps_Lst_Akt:setValueMapped(1, false, false)&#13;&#10;&#9;&#9;timer:setCallback(4, TimerCallback) &#13;&#10;&#9;&#9;timer:startTimer(4, 20000) &#13;&#10;&#13;&#10;&#9;&#9;iCounter = 1&#13;&#10;&#9;&#9;timer:setCallback(21, TimerCallback)&#13;&#10;&#9;&#9;timer:startTimer(21, 100) &#10;&#9;end&#10;end&#13;&#10;"
                   luaMethodLinkedProperty="" luaMethodSource="0" uuid="108293e4b79d487f930b625be5affedd"
                   luaMethodValid="1"/>
      </luaMethodGroup>
      <luaMethodGroup name="assign" uuid="74db83e6f7904b18b93197ed41434fd0">
        <luaMethod luaMethodName="assignPresetVal" luaMethodCode="function assignPresetVal(singlePresetDumpRec)&#13;&#10;&#9;if is_panel_ready() == true and psetDumpRec == false then&#13;&#10;&#13;&#10;&#9;&#9;allFadUnvis()&#13;&#10;&#13;&#10;&#9;&#9;local oneTwoEight = combNib(singlePresetDumpRec:getRange(8 ,2), 8)&#9;&#9;--undocumented, does nothing, stays the same....&#13;&#10;&#9;&#9;local iconVal = combNib(singlePresetDumpRec:getRange(10 ,2), 8)&#13;&#10;&#9;&#9;local chksumCompensate = combNib(singlePresetDumpRec:getRange(40 ,4), 16)&#13;&#10;&#9;&#9;local chksum = combNib(singlePresetDumpRec:getRange(44,4), 16)&#13;&#10;&#13;&#10;&#9;&#9;oneTwoEightSlider:setValueMapped(oneTwoEight, false, true)&#9;&#9;&#9;&#9;--undocumented, does nothing, stays the same....&#13;&#10;&#9;&#9;iconSlider:setValueMapped(iconVal, false, true)&#13;&#10;&#9;&#9;chksumCompensateSlider:setValue(chksumCompensate, false, true)&#13;&#10;&#9;&#9;chksumSlider:setValue(chksum, false, true)&#13;&#10;&#13;&#10;&#9;&#9;assignMixFader(singlePresetDumpRec)&#9;&#13;&#10;&#9;&#9;assignEqAFader(singlePresetDumpRec)&#9;&#13;&#10;&#9;&#9;assignFxAFader(singlePresetDumpRec)&#13;&#10;&#9;&#9;assignEqBFader(singlePresetDumpRec)&#9;&#13;&#10;&#9;&#9;assignFxBFader(singlePresetDumpRec)&#13;&#10;&#9;&#9;assignRtc(singlePresetDumpRec)&#13;&#10;&#9;end&#13;&#10;end"
                   luaMethodLinkedProperty="" luaMethodSource="0" uuid="4a48f8be9e6646a09b38df01dafadfb8"
                   luaMethodValid="1"/>
        <luaMethod luaMethodName="assignPresetName" luaMethodCode="function assignPresetName(PresetName)&#13;&#10;&#13;&#10;&#9;if is_panel_ready() == true and psetDumpRec == false then&#13;&#10;&#9;&#9;local bank = tonumber(PresetName:getRange(6,1):toHexString(1)),16&#13;&#10;&#9;&#9;local bankName = bankNrToName(bank)&#13;&#10;&#13;&#10;&#9;&#9;bankNameLab:getComponent():setPropertyString (&quot;uiLabelText&quot;, bankName)&#13;&#10;&#13;&#10;&#9;&#9;local nr =  string.format(&quot;%d&quot;, tonumber(PresetName:getRange(7,1):toHexString(1),16))&#13;&#10;&#13;&#10;&#9;&#9;psetNr:getComponent():setPropertyString (&quot;uiLabelText&quot;, nr)&#13;&#10;&#13;&#10;&#13;&#10;&#9;&#9;local charNib1 = PresetName:getRange(12,1):toHexString(1)&#13;&#10;&#9;&#9;local charNib2 = PresetName:getRange(13,1):toHexString(1)&#13;&#10;&#9;&#9;local charNib3 = PresetName:getRange(14,1):toHexString(1)&#13;&#10;&#9;&#9;local charNib4 = PresetName:getRange(15,1):toHexString(1)&#13;&#10;&#9;&#9;local charNib5 = PresetName:getRange(16,1):toHexString(1)&#13;&#10;&#9;&#9;local charNib6 = PresetName:getRange(17,1):toHexString(1)&#13;&#10;&#9;&#9;local charNib7 = PresetName:getRange(18,1):toHexString(1)&#13;&#10;&#9;&#9;local charNib8 = PresetName:getRange(19,1):toHexString(1)&#13;&#10;&#9;&#9;local charNib9 = PresetName:getRange(20,1):toHexString(1)&#13;&#10;&#9;&#9;local charNib10 = PresetName:getRange(21,1):toHexString(1)&#13;&#10;&#9;&#9;local charNib11 = PresetName:getRange(22,1):toHexString(1)&#13;&#10;&#9;&#9;local charNib12 = PresetName:getRange(23,1):toHexString(1)&#13;&#10;&#9;&#9;local charNib13 = PresetName:getRange(24,1):toHexString(1)&#13;&#10;&#9;&#9;local charNib14 = PresetName:getRange(25,1):toHexString(1)&#13;&#10;&#9;&#9;local charNib15 = PresetName:getRange(26,1):toHexString(1)&#13;&#10;&#9;&#9;local charNib16 = PresetName:getRange(27,1):toHexString(1)&#13;&#10;&#9;&#9;local charNib17 = PresetName:getRange(28,1):toHexString(1)&#13;&#10;&#9;&#9;local charNib18 = PresetName:getRange(29,1):toHexString(1)&#13;&#10;&#9;&#9;local charNib19 = PresetName:getRange(30,1):toHexString(1)&#13;&#10;&#9;&#9;local charNib20 = PresetName:getRange(31,1):toHexString(1)&#13;&#10;&#9;&#9;local charNib21 = PresetName:getRange(32,1):toHexString(1)&#13;&#10;&#9;&#9;local charNib22 = PresetName:getRange(33,1):toHexString(1)&#13;&#10;&#9;&#9;local charNib23 = PresetName:getRange(34,1):toHexString(1)&#13;&#10;&#9;&#9;local charNib24 = PresetName:getRange(35,1):toHexString(1)&#13;&#10;&#9;&#9;local charNib25 = PresetName:getRange(36,1):toHexString(1)&#13;&#10;&#9;&#9;local charNib26 = PresetName:getRange(37,1):toHexString(1)&#13;&#10;&#9;&#9;local charNib27 = PresetName:getRange(38,1):toHexString(1)&#13;&#10;&#9;&#9;local charNib28 = PresetName:getRange(39,1):toHexString(1)&#13;&#10;&#9;&#9;&#13;&#10;&#9;&#9;local pSetChr1 = string.char(combine4n(tonumber(charNib1, 16), tonumber(charNib2, 16)))&#13;&#10;&#9;&#9;local pSetChr2 = string.char(combine4n(tonumber(charNib3, 16), tonumber(charNib4, 16)))&#13;&#10;&#9;&#9;local pSetChr3 = string.char(combine4n(tonumber(charNib5, 16), tonumber(charNib6, 16)))&#13;&#10;&#9;&#9;local pSetChr4 = string.char(combine4n(tonumber(charNib7, 16), tonumber(charNib8, 16)))&#13;&#10;&#9;&#9;local pSetChr5 = string.char(combine4n(tonumber(charNib9, 16), tonumber(charNib10, 16)))&#13;&#10;&#9;&#9;local pSetChr6 = string.char(combine4n(tonumber(charNib11, 16), tonumber(charNib12, 16)))&#13;&#10;&#9;&#9;local pSetChr7 = string.char(combine4n(tonumber(charNib13, 16), tonumber(charNib14, 16)))&#13;&#10;&#9;&#9;local pSetChr8 = string.char(combine4n(tonumber(charNib15, 16), tonumber(charNib16, 16)))&#13;&#10;&#9;&#9;local pSetChr9 = string.char(combine4n(tonumber(charNib17, 16), tonumber(charNib18, 16)))&#13;&#10;&#9;&#9;local pSetChr10 = string.char(combine4n(tonumber(charNib19, 16), tonumber(charNib20, 16)))&#13;&#10;&#9;&#9;local pSetChr11 = string.char(combine4n(tonumber(charNib21, 16), tonumber(charNib22, 16)))&#13;&#10;&#9;&#9;local pSetChr12 = string.char(combine4n(tonumber(charNib23, 16), tonumber(charNib24, 16)))&#13;&#10;&#9;&#9;local pSetChr13 = string.char(combine4n(tonumber(charNib25, 16), tonumber(charNib26, 16)))&#13;&#10;&#9;&#9;local pSetChr14 = string.char(combine4n(tonumber(charNib27, 16), tonumber(charNib28, 16)))&#13;&#10;&#13;&#10;&#9;&#9;local pSetNm = pSetChr1.. pSetChr2.. pSetChr3.. pSetChr4.. pSetChr5.. pSetChr6.. pSetChr7.. pSetChr8.. pSetChr9.. pSetChr10.. pSetChr11.. pSetChr12.. pSetChr13.. pSetChr14&#13;&#10;&#9;&#9;PresetLabel:getComponent():setPropertyString (&quot;uiLabelText&quot;, pSetNm)&#9;&#13;&#10;&#9;end&#13;&#10;end"
