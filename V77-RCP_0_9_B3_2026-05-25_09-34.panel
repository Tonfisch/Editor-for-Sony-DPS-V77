        <luaMethod luaMethodName="on_panel_load" luaMethodCode="function on_panel_load()&#13;&#10;&#13;&#10;&#9;panel:setPropertyInt(&quot;panelMidiPauseOut&quot;, 0)-- unmutes the panel's MIDI Out&#13;&#10;&#9;--dumpstate = false&#13;&#10;&#9;--dumpActiv = panel:getModulatorByName(&quot;dumpActiv&quot;)&#13;&#10;&#9;--Wait_1_Activ = panel:getModulatorByName(&quot;Wait_1_Activ&quot;)&#13;&#10;&#9;--Wait_2_Activ = panel:getModulatorByName(&quot;Wait_2_Activ&quot;)&#13;&#10;&#9;-- Set Global MidiChannel Variable, panel set to 1 equates to zero when sending Hex&#13;&#10;&#9;killtimer=false&#13;&#10;&#9;PBAR = panel:getModulatorByName(&quot;ProBar&quot;):getComponent()&#13;&#10;&#9;PBAR:setValue(0, true)&#13;&#10;&#9;midiData = {}&#13;&#10;&#9;for i = 1, 10 do&#13;&#10;&#9;&#9;midiData[i] = string.format(&quot;F0 00 00 %.2x F7&quot;, math.random(0, 127))&#13;&#10;&#9;end&#13;&#10;&#9;PanelWatch = panel:getModulatorByName(&quot;PanelWatch&quot;)&#13;&#10;&#9;MidiChannel=panel:getProperty(&quot;panelMidiOutputChannelDevice&quot;)-1&#13;&#10;&#9;&#9;-- Your method code here&#13;&#10;&#9;InfoDisplay = panel:getModulatorByName(&quot;InfoDisplay&quot;)&#13;&#10;&#9;AlgoTable()&#13;&#10;&#9;sliderContentTable()&#13;&#10;&#9;psetNr = panel:getModulatorByName(&quot;psetNr&quot;)&#13;&#10;&#9;PresetLabel = panel:getModulatorByName(&quot;PresetLabel&quot;)&#13;&#10;&#9;PsetListComboBank3 = panel:getModulatorByName(&quot;PsetListComboBank3&quot;)&#13;&#10;&#9;&#13;&#10;&#9;prefix = panel:getModulatorByName(&quot;praefix&quot;)&#13;&#10;&#9;&#13;&#10;&#9;PreferencesButtHide = panel:getModulatorByName(&quot;PreferencesButtHide&quot;)&#13;&#10;&#9;PreferencesButtShow = panel:getModulatorByName(&quot;PreferencesButtShow&quot;)&#13;&#10;&#9;AddButtActiv = panel:getModulatorByName(&quot;AddButtActiv&quot;)&#13;&#10;&#9;&#13;&#10;&#9;Bypass = panel:getModulatorByName(&quot;Bypass&quot;)&#13;&#10;&#9;Bank = panel:getModulatorByName(&quot;Bank&quot;)&#13;&#10;&#9;Edit = panel:getModulatorBy