torByName(&quot;PatchListbox&quot;)&#13;&#10;&#9;PatchPresetCombo = panel:getModulatorByName(&quot;PatchPresetCombo&quot;)&#13;&#10;&#9;PatchBanKCombo = panel:getModulatorByName(&quot;PatchBanKCombo&quot;)&#13;&#10;&#9;PedalPatchListbox = panel:getModulatorByName(&quot;PedalPatchListbox&quot;)&#13;&#10;&#9;PedalPatchPresetCombo = panel:getModulatorByName(&quot;PedalPatchPresetCombo&quot;)&#13;&#10;&#9;PedalPatchBanKCombo = panel:getModulatorByName(&quot;PedalPatchBanKCombo&quot;)&#13;&#10;&#9;saveSystemDataBut = panel:getModulatorByName(&quot;saveSystemDataBut&quot;)&#13;&#10;&#9;savTempPatch = panel:getModulatorByName(&quot;savTempPatch&quot;)&#13;&#10;&#9;savTempPanelPatch = panel:getModulatorByName(&quot;savTempPanelPatch&quot;)&#13;&#10;&#9;SysUnvisible2 = panel:getModulatorByName(&quot;SysUnvisible2&quot;)&#13;&#10;&#9;SysUnvisible = panel:getModulatorByName(&quot;SysUnvisible&quot;)&#13;&#10;&#9;&#13;&#10;&#9;ParaNameLong = panel:getModulatorByName(&quot;ParaNameLong&quot;)&#13;&#10;&#9;PsetListBox1 = panel:getModulatorByName(&quot;PsetListBox1&quot;)&#13;&#10;&#9;PsetListBox2 = panel:getModulatorByName(&quot;PsetListBox2&quot;)&#13;&#10;&#9;PsetListBoxUser1 = panel:getModulatorByName(&quot;PsetListBoxUser1&quot;)&#13;&#10;&#9;PsetListBoxUser2 = panel:getModulatorByName(&quot;PsetListBoxUser2&quot;)&#13;&#10;&#9;bankNameLab = panel:getModulatorByName(&quot;bankNameLab&quot;)&#13;&#10;&#9;getAllUserPsetDmps3 = panel:getModulatorByName(&quot;getAllUserPsetDmps3&quot;)&#13;&#10;&#9;getUserPsetDmps1 = panel:getModulatorByName(&quot;getUserPsetDmps1&quot;)&#13;&#10;&#9;getUserPsetDmps2 = panel:getModulatorByName(&quot;getUserPsetDmps2&quot;)&#13;&#10;&#9;&#13;&#10;&#9;constructSysList()&#13;&#10;&#9;blankPsetList()&#13;&#10;&#9;pListTables()&#13;&#10;&#9;reAssignLists()&#13;&#10;&#9;RtcList()&#13;&#10;&#9;ldSelPset0 = panel:getModulatorByName(&quot;ldSelPset0&quot;)&#13;&#10;&#9;ldSelPset1 = panel:getModulatorByName(&quot;ldSelPset1&quot;)&#13;&#10;&#9;ldSelPset2 = panel:getModulatorByName(&quot;ldSelPset2&quot;)&#13;&#10;&#9;ldSelPset3 = panel:getModulatorByName(&quot;ldSelPset3&quot;)&#13;&#10;&#9;svToSelPset2 = panel:getModulatorByName(&quot;svToSelPset2&quot;)&#13;&#10;&#9;svToSelPset3 = panel:getModulatorByName(&quot;svToSelPset3&quot;)&#13;&#10;&#9;renSelPsetU1 = panel:getModulatorByName(&quot;renSelPsetU1&quot;)&#13;&#10;&#9;renSelPsetU2 = panel:getModulatorByName(&quot;renSelPsetU2&quot;)&#13;&#10;&#9;&#13;&#10;&#9;PanelWatch:setValueMapped(2, false, false)&#13;&#10;&#9;timer:setCallback(5, TimerCallback) -- TimerId 5 assignlistbox&#13;&#10;&#9;timer:startTimer(5, 500)&#13;&#10;&#9;Gt_Ps_Lst_Akt = panel:getModulatorByName(&quot;Gt_Ps_Lst_Akt&quot;)&#13;&#10;&#9;free = 1&#13;&#10;&#9;RoutingTab:getComponent():setProperty(&quot;uiTabsCurrentTab&quot;,(5) ,false)&#13;&#10;&#9;psetDumpRec = false&#13;&#10;&#9;panel:getCanvas():getLayerByName('Masking'):setVisible(true)&#13;&#10;&#9;panel:getComponent(&quot;InfoDisplay&quot;):setProperty(&quot;uiLabelText&quot;, (&quot;&quot;), false)&#13;&#10;&#9;start_bPanel_Timer()&#13;&#10;end"
