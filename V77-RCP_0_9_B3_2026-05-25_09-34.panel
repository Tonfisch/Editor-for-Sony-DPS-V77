        <luaMethod luaMethodName="assignPsetListBox" luaMethodCode="function assignPsetListBox(tableName, listbox)&#13;&#10;&#13;&#10;&#9;if is_panel_ready() == true then-- and psetDumpRec == false then&#13;&#10;&#13;&#10;&#9;&#9;-- Quelle: PsetLst_User2&#13;&#10;&#9;&#9;-- Ziel: Langer String nach dem Muster [Key]TAB[pName]\n&lt;n&#228;chstes Element&gt;&#9;&#13;&#10;&#9;&#9;-- Schritt 1: Original-Table -&gt; neue Table, in der Strings sind in denen der vorherige Key &amp; das Attribut pName hintereinander gestellt sind&#13;&#10;&#9;&#9;local s1 = {}&#13;&#10;&#9;&#9;for i=1,99 do&#13;&#10;&#9;&#9;&#9;table.insert(s1, i..&quot;\t&quot;..tableName[i][&quot;pName&quot;])&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;-- Schritt 2: Alle Listenelemente aus Schritt 1 durch ein \n trennen&#13;&#10;&#9;&#9;local s2 = table.concat(s1, &quot;\n&quot;)&#13;&#10;&#9;&#9;s2 = s2:gsub('[=&quot;\']', '&#96;')&#13;&#10;&#9;&#9;-- fertig&#13;&#10;&#9;&#9;panel:getComponent(listbox):setPropertyString(&quot;uiListBoxContent&quot;,s2)&#13;&#10;&#9;end&#13;&#10;end"
                   luaMethodLinkedProperty="" luaMethodSource="0" uuid="92a1a98f05e64deab90056927421b8b5"
                   luaMethodValid="1"/>
