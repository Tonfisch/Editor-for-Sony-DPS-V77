c[12][&quot;Val&quot;] = Rtc2ParMaxVal&#13;&#10;&#9;&#9;paraValRtc[13][&quot;Val&quot;] = Rtc3SourceVal&#13;&#10;&#9;&#9;paraValRtc[14][&quot;Val&quot;] = Rtc3ParamVal&#13;&#10;&#9;&#9;paraValRtc[15][&quot;Val&quot;] = Rtc3scMinVal&#13;&#10;&#9;&#9;paraValRtc[16][&quot;Val&quot;] = Rtc3scMaxVal&#13;&#10;&#9;&#9;paraValRtc[17][&quot;Val&quot;] = Rtc3ParMinVal&#13;&#10;&#9;&#9;paraValRtc[18][&quot;Val&quot;] = Rtc3ParMaxVal&#13;&#10;&#9;&#9;paraValRtc[19][&quot;Val&quot;] = Rtc4SourceVal&#13;&#10;&#9;&#9;paraValRtc[20][&quot;Val&quot;] = Rtc4ParamVal&#13;&#10;&#9;&#9;paraValRtc[21][&quot;Val&quot;] = Rtc4scMinVal&#13;&#10;&#9;&#9;paraValRtc[22][&quot;Val&quot;] = Rtc4scMaxVal&#13;&#10;&#9;&#9;paraValRtc[23][&quot;Val&quot;] = Rtc4ParMinVal&#13;&#10;&#9;&#9;paraValRtc[24][&quot;Val&quot;] = Rtc4ParMaxVal&#13;&#10;&#9;&#9;paraValRtc[25][&quot;Val&quot;] = Rtc5SourceVal&#13;&#10;&#9;&#9;paraValRtc[26][&quot;Val&quot;] = Rtc5ParamVal&#13;&#10;&#9;&#9;paraValRtc[27][&quot;Val&quot;] = Rtc5scMinVal&#13;&#10;&#9;&#9;paraValRtc[28][&quot;Val&quot;] = Rtc5scMaxVal&#13;&#10;&#9;&#9;paraValRtc[29][&quot;Val&quot;] = Rtc5ParMinVal&#13;&#10;&#9;&#9;paraValRtc[30][&quot;Val&quot;] = Rtc5ParMaxVal&#13;&#10;&#9;&#9;paraValRtc[31][&quot;Val&quot;] = Rtc6SourceVal&#13;&#10;&#9;&#9;paraValRtc[32][&quot;Val&quot;] = Rtc6ParamVal&#13;&#10;&#9;&#9;paraValRtc[33][&quot;Val&quot;] = Rtc6scMinVal&#13;&#10;&#9;&#9;paraValRtc[34][&quot;Val&quot;] = Rtc6scMaxVal&#13;&#10;&#9;&#9;paraValRtc[35][&quot;Val&quot;] = Rtc6ParMinVal&#13;&#10;&#9;&#9;paraValRtc[36][&quot;Val&quot;] = Rtc6ParMaxVal&#13;&#10;&#13;&#10;&#13;&#10;&#9;&#9;paraValApc[1][&quot;Val&quot;] = Apc1ParamVal&#13;&#10;&#9;&#9;paraValApc[2][&quot;Val&quot;] = Apc2ParamVal&#13;&#10;&#9;&#9;paraValApc[3][&quot;Val&quot;] = Apc3ParamVal&#13;&#10;&#9;&#9;paraValApc[4][&quot;Val&quot;] = Apc4ParamVal&#13;&#10;&#9;&#9;paraValApc[5][&quot;Val&quot;] = Apc5ParamVal&#13;&#10;&#9;&#9;paraValApc[6][&quot;Val&quot;] = Apc6ParamVal&#13;&#10;end"
