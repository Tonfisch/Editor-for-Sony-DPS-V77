        <luaMethod luaMethodName="startProgressBar" luaMethodCode="startProgressBar = function(--[[ CtrlrModulator --]] mod, --[[ number --]] value, --[[ number --]] source)&#13;&#10;&#9;if is_panel_ready() == true then&#13;&#10;&#9;&#9;local a = tonumber(mod:getProperty(&quot;modulatorCustomIndex&quot;))&#13;&#10;&#9;&#9;progressBar = AlertWindow(&quot;\nSend MIDI Request now?\n\n&quot;, &quot;\n\n\n\n\n\n&quot;, AlertWindow.NoIcon) -- global&#13;&#10;&#9;&#9;progressBar:addButton(&quot;    OK    &quot;, 1, KeyPress(KeyPress.returnKey), KeyPress())&#13;&#10;&#9;&#9;progressBar:addButton(&quot;Cancel&quot;, 0, KeyPress(KeyPress.escapeKey), KeyPress())&#13;&#10;&#9;&#9;progressBar:setEscapeKeyCancels(true)&#13;&#10;&#9;&#13;&#10;&#9;&#9;if PBAR ~= nil then&#13;&#10;&#9;&#9;&#9;progressBar:addCustomComponent(PBAR)&#13;&#10;&#9;&#9;&#9;PBAR:setValue(0, true)&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#13;&#10;&#9;&#9;local ret = progressBar:runModalLoop()&#13;&#10;&#9;&#13;&#10;&#9;&#9;if ret == 1 then&#13;&#10;&#9;&#9;&#9;if a == 1 then&#13;&#10;&#9;&#9;&#9;&#9;progressBar:removeChildComponent(2)&#13;&#10;&#9;&#9;&#9;&#9;getAllUserPresetDumps()&#13;&#10;&#9;&#9;&#9;&#9;counterprogress = 0&#13;&#10;&#9;&#9;&#9;&#9;timer:setCallback(22, TimerCallback)&#13;&#10;&#9;&#9;&#9;&#9;timer:startTimer(22, 400)&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;if a == 2 then&#13;&#10;&#9;&#9;&#9;&#9;progressBar:removeChildComponent(2)&#13;&#10;&#9;&#9;&#9;&#9;getUser1PresetDumps()&#13;&#10;&#9;&#9;&#9;&#9;counterprogress = 0&#13;&#10;&#9;&#9;&#9;&#9;timer:setCallback(22, TimerCallback)&#13;&#10;&#9;&#9;&#9;&#9;timer:startTimer(22, 200)&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;if a == 3 then&#13;&#10;&#9;&#9;&#9;&#9;progressBar:removeChildComponent(2)&#13;&#10;&#9;&#9;&#9;&#9;getUser2PresetDumps()&#13;&#10;&#9;&#9;&#9;&#9;counterprogress = 0&#13;&#10;&#9;&#9;&#9;&#9;timer:setCallback(22, TimerCallback)&#13;&#10;&#9;&#9;&#9;&#9;timer:startTimer(22, 200)&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;else&#13;&#10;&#9;&#9;progressBar:setVisible(false)&#13;&#10;&#9;&#9;end&#13;&#10;&#9;end&#9;&#13;&#10;end&#13;&#10;&#13;&#10;&#13;&#10;"
                   luaMethodLinkedProperty="" luaMethodSource="0" uuid="202f4e44f8814c7a85aee703fcc58c93"
                   luaMethodValid="1"/>
