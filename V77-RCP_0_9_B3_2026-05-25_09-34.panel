        <luaMethod luaMethodName="constructSysList" luaMethodCode="function constructSysList()&#13;&#10;&#10;&#9;SysTable = {}&#13;&#10;&#9;PatchTable ={}&#13;&#10;&#9;PedalPatchTable ={}&#13;&#10;&#13;&#10;&#9;for i = 1,24 do&#13;&#10;&#9;&#9;SysTable[i] = nil&#13;&#10;&#9;end&#13;&#10;&#13;&#10;&#9;for i = 1,128 do&#13;&#10;&#9;&#9;PatchTable[i]={[&quot;patchBank&quot;]=nil,[&quot;patchPreset&quot;]=nil}&#13;&#10;&#9;end&#9;&#13;&#10;&#9;for i = 1,10 do&#13;&#10;&#9;&#9;PedalPatchTable[i]={[&quot;patchBank&quot;]=nil,[&quot;patchPreset&quot;]=nil}&#13;&#10;&#9;end&#9;&#10;end&#13;&#10;"
