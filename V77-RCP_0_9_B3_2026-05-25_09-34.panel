        <luaMethod luaMethodName="extractDumpListsToHex" luaMethodCode="function extractDumpListsToHex(bank, preset, newName)&#13;&#10;&#13;&#10;&#9;local DevCode = string.format('f0 4c 0%.1x 15 01', MidiChannel)&#13;&#10;&#9;local parameter = string.format(&quot;%.2x&quot;, 112)&#13;&#10;&#9;local destBank = string.format(&quot;%.2x&quot;,bank)&#13;&#10;&#9;local destPreset = string.format(&quot;%.2x&quot;,preset)&#13;&#10;&#13;&#10;&#9;local m = ''&#13;&#10;&#9;local l = ''&#13;&#10;&#9;local oneTwoEight = nibbles2or4(oneTwoEightSlider:getValueMapped(), 8)&#9;&#9;&#9;--undocumented, does nothing, stays the same....&#13;&#10;&#9;local iconVal = nibbles2or4(iconSlider:getValueMapped(), 8)&#13;&#10;&#9;local pstNm = getCurrPrstNm()&#13;&#10;&#9;local pstNmnew = newName or pstNm&#13;&#10;&#9;local chksumCompensate = nibbles2or4(chksumCompensateSlider:getValue(), 16)&#13;&#10;&#9;local chksum = nibbles2or4(chksumSlider:getValue(), 16)&#13;&#10;&#9;local EOX = 'F7'&#13;&#10;&#13;&#10; &#9;m = m..DevCode..' '..parameter..' '..destBank..' '..destPreset..' '..oneTwoEight..' '..iconVal..' '..pstNmnew..chksumCompensate..' '..chksum..' '&#13;&#10;&#9;for i = 0, 11 do&#13;&#10;&#9;&#9;l = nibbles2or4(sixtnbTo8b(paraValMix[i][&quot;Val&quot;]), 8)&#13;&#10;&#9;&#9;m = m..l..' '&#13;&#10;&#9;end&#13;&#10;&#13;&#10;&#9;for i = 0, 17 do&#13;&#10;&#9;&#9;l = nibbles2or4(sixtnbTo8b(paraValEqA[i][&quot;Val&quot;]), 8)&#13;&#10;&#9;&#9;m = m..l..' '&#13;&#10;&#9;end&#13;&#10;&#13;&#10;&#9;for i = 0, 29 do&#13;&#10;&#13;&#10;&#9;l = nibbles2or4(paraValFxA[i][&quot;Val&quot;], 16)&#13;&#10;&#9;&#9;m = m..l..' '&#13;&#10;&#9;end&#13;&#10;&#13;&#10;&#9;for i = 0, 17 do&#13;&#10;&#9;&#9;l = nibbles2or4(sixtnbTo8b(paraValEqB[i][&quot;Val&quot;]), 8)&#13;&#10;&#9;&#9;m = m..l..' '&#13;&#10;&#9;end&#13;&#10;&#13;&#10;&#9;for i = 0, 29 do&#13;&#10;&#9;&#9;l = nibbles2or4(paraValFxB[i][&quot;Val&quot;], 16)&#13;&#10;&#9;&#9;m = m..l..' '&#13;&#10;&#9;end&#13;&#10;&#9;--RTC&#13;&#10;&#9;local ind = 1&#13;&#10;&#9;for i = ind, ind+3 do&#9;--RTC 8b&#13;&#10;&#9;&#9;l = nibbles2or4(paraValRtc[i][&quot;Val&quot;], 8)&#13;&#10;&#9;&#9;m = m..l..' '&#13;&#10;&#9;end&#13;&#10;&#13;&#10;&#9;for i = ind+4, ind+5 do&#9;--RTC 16b&#13;&#10;&#9;&#9;l = nibbles2or4(paraValRtc[i][&quot;Val&quot;], 16)&#13;&#10;&#9;&#9;m = m..l..' '&#13;&#10;&#9;end&#13;&#10;&#13;&#10;&#9;ind = 7&#13;&#10;&#9;for i = ind, ind+3 do&#9;--RTC 8b&#13;&#10;&#9;&#9;l = nibbles2or4(paraValRtc[i][&quot;Val&quot;], 8)&#13;&#10;&#9;&#9;m = m..l..' '&#13;&#10;&#9;end&#13;&#10;&#13;&#10;&#9;for i = ind+4, ind+5 do&#9;--RTC 16b&#13;&#10;&#9;&#9;l = nibbles2or4(paraValRtc[i][&quot;Val&quot;], 16)&#13;&#10;&#9;&#9;m = m..l..' '&#13;&#10;&#9;end&#13;&#10;&#13;&#10;&#9;ind = 13&#13;&#10;&#9;for i = ind, ind+3 do&#9;--RTC 8b&#13;&#10;&#9;&#9;l = nibbles2or4(paraValRtc[i][&quot;Val&quot;], 8)&#13;&#10;&#9;&#9;m = m..l..' '&#13;&#10;&#9;end&#13;&#10;&#13;&#10;&#9;for i = ind+4, ind+5 do&#9;--RTC 16b&#13;&#10;&#9;&#9;l = nibbles2or4(paraValRtc[i][&quot;Val&quot;], 16)&#13;&#10;&#9;&#9;m = m..l..' '&#13;&#10;&#9;end&#13;&#10;&#13;&#10;&#9;ind = 19&#13;&#10;&#9;for i = ind, ind+3 do&#9;--RTC 8b&#13;&#10;&#9;&#9;l = nibbles2or4(paraValRtc[i][&quot;Val&quot;], 8)&#13;&#10;&#9;&#9;m = m..l..' '&#13;&#10;&#9;end&#13;&#10;&#13;&#10;&#9;for i = ind+4, ind+5 do&#9;--RTC 16b&#13;&#10;&#9;&#9;l = nibbles2or4(paraValRtc[i][&quot;Val&quot;], 16)&#13;&#10;&#9;&#9;m = m..l..' '&#13;&#10;&#9;end&#13;&#10;&#13;&#10;&#9;ind = 25&#13;&#10;&#9;for i = ind, ind+3 do&#9;--RTC 8b&#13;&#10;&#9;&#9;l = nibbles2or4(paraValRtc[i][&quot;Val&quot;], 8)&#13;&#10;&#9;&#9;m = m..l..' '&#13;&#10;&#9;end&#13;&#10;&#13;&#10;&#9;for i = ind+4, ind+5 do&#9;--RTC 16b&#13;&#10;&#9;&#9;l = nibbles2or4(paraValRtc[i][&quot;Val&quot;], 16)&#13;&#10;&#9;&#9;m = m..l..' '&#13;&#10;&#9;end&#13;&#10;&#13;&#10;&#9;ind = 31&#13;&#10;&#9;for i = ind, ind+3 do&#9;--RTC 8b&#13;&#10;&#9;&#9;l = nibbles2or4(paraValRtc[i][&quot;Val&quot;], 8)&#13;&#10;&#9;&#9;m = m..l..' '&#13;&#10;&#9;end&#13;&#10;&#13;&#10;&#9;for i = ind+4, ind+5 do&#9;--RTC 16b&#13;&#10;&#9;&#9;l = nibbles2or4(paraValRtc[i][&quot;Val&quot;], 16)&#13;&#10;&#9;&#9;m = m..l..' '&#13;&#10;&#9;end&#13;&#10;&#13;&#10;--APC&#13;&#10;&#13;&#10;&#9;for i = 1, 6 do&#13;&#10;&#9;&#9;l = nibbles2or4(paraValApc[i][&quot;Val&quot;], 8)&#13;&#10;&#9;&#9;m = m..l..' '..'00 00'..' '&#13;&#10;&#9;end&#13;&#10;&#9;m = m..EOX&#13;&#10;&#13;&#10;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(m))&#13;&#10;end"
                   luaMethodLinkedProperty="" luaMethodSource="0" uuid="6dcb1eaea758408a8557e2ff9bd17cd9"
                   luaMethodValid="1"/>
        <luaMethod luaMethodName="CallGatherDumpLists" luaMethodCode="function CallGatherDumpLists()&#13;&#10;&#9;if is_panel_ready() == true and psetDumpRec == false then&#10;&#9;&#9;forDumpEqA()&#13;&#10;&#9;&#9;forDumpFxA()&#10;&#9;&#9;forDumpEqB()&#13;&#10;&#9;&#9;forDumpFxB()&#10;&#9;&#9;forDumpMix()&#13;&#10;&#9;&#9;forDumpRtcApc()&#13;&#10;&#9;end&#10;end"
