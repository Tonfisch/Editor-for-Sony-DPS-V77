        <luaMethod luaMethodName="layerVisible" luaMethodCode="layerVisible = function(--[[ CtrlrModulator --]] mod, --[[ number --]] value, --[[ number --]] source)&#13;&#10;&#13;&#10;&#9;if is_panel_ready() == true and source ~= 5 then&#13;&#10;&#9;&#9;&#9;&#13;&#10;&#9;&#9;local w = tonumber(mod:getProperty(&quot;modulatorCustomIndex&quot;))&#13;&#10;&#9;&#9;local name = mod:getProperty(&quot;modulatorCustomName&quot;)&#13;&#10;&#9;&#9;local Bol1&#13;&#10;&#13;&#10;&#9;&#9;if w == 1 then&#13;&#10;&#9;&#9;&#9;Bol1 = true&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;if w == 0 then&#13;&#10;&#9;&#9;&#9;Bol1 = false&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;if Bol1 ~= nil then&#13;&#10;&#9;&#9;&#9;panel:getCanvas():getLayerByName(name):setVisible(Bol1)&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;if name == 'System' and Bol1 == true then&#13;&#10;&#9;&#9;&#9;reqSysDmp()&#13;&#10;&#9;&#9;end&#13;&#10;&#9;end&#10;end&#13;&#10;"
                   luaMethodLinkedProperty="" luaMethodSource="0" uuid="2f6e4023b6bf43e394126bf9cbc43665"
                   luaMethodValid="1"/>
        <luaMethod luaMethodName="PrefereceVisible" luaMethodCode="&#10;PrefereceVisible = function(--[[ CtrlrModulator --]] mod, --[[ number --]] value, --[[ number --]] source)&#13;&#10;&#13;&#10;&#9;if is_panel_ready() == true and source ~= 5 then&#13;&#10;&#9;&#9;&#9;&#13;&#10;&#9;&#9;local w = tonumber(mod:getProperty(&quot;modulatorCustomIndex&quot;))&#13;&#10;&#9;&#9;local name = mod:getProperty(&quot;modulatorCustomName&quot;)&#13;&#10;&#9;&#9;local Bol1&#13;&#10;&#13;&#10;&#9;&#9;if w == 1 then&#13;&#10;&#9;&#9;&#9;Bol1 = true&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;if w == 0 then&#13;&#10;&#9;&#9;&#9;Bol1 = false&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;if Bol1 ~= nil then&#13;&#10;&#9;&#9;&#9;panel:getCanvas():getLayerByName(name):setVisible(Bol1)&#13;&#10;&#9;&#9;end&#13;&#10;&#9;end&#10;end"
                   luaMethodLinkedProperty="" luaMethodSource="0" uuid="a21ee67e554846fe8b8a879df34efa4d"
                   luaMethodValid="1"/>
