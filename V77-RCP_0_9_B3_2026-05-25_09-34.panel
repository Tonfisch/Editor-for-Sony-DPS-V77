        <luaMethod luaMethodName="assignPatchListbox" luaMethodCode="function assignPatchListbox(tableName, listbox, listrows)&#13;&#10;&#13;&#10;&#9;if is_panel_ready() == true then-- and psetDumpRec == false then&#13;&#10;&#13;&#10;&#9;&#9;-- Quelle: PsetLst_User2&#13;&#10;&#9;&#9;-- Ziel: Langer String nach dem Muster [Key]TAB[pName]\n&lt;n&#228;chstes Element&gt;&#9;&#13;&#10;&#9;&#9;-- Schritt 1: Original-Table -&gt; neue Table, in der Strings sind in denen der vorherige Key &amp; das Attribut pName hintereinander gestellt sind&#13;&#10;&#9;&#9;local s1 = {}&#13;&#10;&#9;&#9;for i=1,listrows do&#13;&#10;&#9;&#9;&#9;--local nr = &#13;&#10;&#9;&#9;&#9;if PatchTable[i][&quot;patchBank&quot;] &lt;= 1 then&#13;&#10;&#9;&#9;&#9;&#9;table.insert(s1, i..&quot;\t&quot;..'Pset-Bank '..(tableName[i][&quot;patchBank&quot;]+1)..&quot;\t&quot;..'Preset '..tableName[i][&quot;patchPreset&quot;]+1)&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;if PatchTable[i][&quot;patchBank&quot;] &gt;= 2 then&#13;&#10;&#9;&#9;&#9;&#9;table.insert(s1, i..&quot;\t&quot;..'User-Bank '..(tableName[i][&quot;patchBank&quot;]-1)..&quot;\t&quot;..'Preset '..tableName[i][&quot;patchPreset&quot;]+1)&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;--PatchTable[i]={[&quot;patchBank&quot;]=nil,[&quot;patchPreset&quot;]=nil}&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;-- Schritt 2: Alle Listenelemente aus Schritt 1 durch ein \n trennen&#13;&#10;&#9;&#9;local s2 = table.concat(s1, &quot;\n&quot;)&#13;&#10;--&#9;&#9;s2 = s2:gsub('[=&quot;\']', '&#96;')&#13;&#10;&#9;&#9;-- fertig&#13;&#10;&#9;&#9;panel:getComponent(listbox):setPropertyString(&quot;uiListBoxContent&quot;,s2)&#13;&#10;&#9;&#9;deSelectListRows('PatchListbox')&#13;&#10;&#9;&#9;deSelectListRows('PedalPatchListbox')&#13;&#10;&#9;end&#13;&#10;end"
                   luaMethodLinkedProperty="" luaMethodSource="0" uuid="4d7ba20844b648d9a65f6bf1d28dbea6"
                   luaMethodValid="1"/>
        <luaMethod luaMethodName="assignInfoDisplay" luaMethodCode="function assignInfoDisplay(text)&#13;&#10;&#13;&#10;panel:getComponent(&quot;InfoDisplay&quot;):setProperty(&quot;uiLabelText&quot;, (text), false)&#13;&#10;&#9;timer:setCallback(24, TimerCallback) -- TimerId 5 assignlistbox&#13;&#10;&#9;timer:startTimer(24, 3000)&#13;&#10;&#13;&#10;end"
                   luaMethodLinkedProperty="" luaMethodSource="0" uuid="2b8dd21255a5454683c43b18be798d78"
                   luaMethodValid="1"/>
      </luaMethodGroup>
      <luaMethodGroup name="chMod" uuid="b05cb1f9803d403b9d4bb8793ec2f721">
        <luaMethod luaMethodName="snd16BitVal" luaMethodCode="snd16BitVal = function(--[[ CtrlrModulator --]] mod, --[[ number --]] value, --[[ number --]] source)&#10;&#13;&#10;&#9;if is_panel_ready() == true and source ~= 5 then&#13;&#10;&#9;&#9;local DevCode = string.format('F0 4C 0%.1x 15 01', MidiChannel) &#13;&#10;&#9;&#9;local v = string.format(&quot;%.2x&quot;, (tonumber(mod:getProperty(&quot;modulatorCustomIndexGroup&quot;))))&#13;&#10;&#9;&#9;local w = string.format(&quot;%.2x&quot;, (tonumber(mod:getProperty(&quot;modulatorCustomIndex&quot;))))&#13;&#10;&#9;&#9;local paramValue_1 = '00'&#13;&#10;&#9;&#9;local x = tonumber(mod:getValueMapped())&#13;&#10;&#13;&#10;&#9;&#9;local message = table.concat({DevCode, paramValue_1, v, w, nibbles2or4(x, 16), 'F7'}, ' ')&#13;&#10;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(message))&#13;&#10;&#13;&#10;&#9;end&#13;&#10;end"
                   luaMethodLinkedProperty="" luaMethodSource="0" uuid="24d2b09bace046b3bd9dbf94d2d01dac"
                   luaMethodValid="1"/>
        <luaMethod luaMethodName="chModAlgo" luaMethodCode="chModAlgo = function(--[[ CtrlrModulator --]] mod, --[[ number --]] value, --[[ number --]] source)&#13;&#10;--dump('chmod: ')&#10;--dump(source)&#13;&#10;&#9;if is_panel_ready() == true and source == 4 then&#13;&#10;&#9;&#9;local DevCode = string.format('F0 4C 0%.1x 15 01', MidiChannel) &#13;&#10;&#9;&#9;local v = string.format(&quot;%.2x&quot;, (tonumber(mod:getProperty(&quot;modulatorCustomIndexGroup&quot;))))&#13;&#10;&#9;&#9;local block = tonumber(mod:getProperty(&quot;modulatorCustomIndexGroup&quot;))&#13;&#10;&#9;&#9;local w = string.format(&quot;%.2x&quot;, (tonumber(mod:getProperty(&quot;modulatorCustomIndex&quot;))))&#13;&#10;&#9;&#9;local paramValue_1 = '00'&#13;&#10;&#9;&#9;local x = tonumber(mod:getValueMapped())&#13;&#10;&#9;&#9;local ms = 100&#13;&#10;--dump(source)&#13;&#10;&#9;&#9;local message = table.concat({DevCode, paramValue_1, v, w, nibbles2or4(x, 16), 'F7'}, ' ')&#13;&#10;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(message))&#13;&#10;&#13;&#10;&#9;&#9;if block == 1 then&#9;&#13;&#10;&#9;&#9;&#9;timer:setCallback(8, TimerCallback) -- TimerId &#13;&#10;&#9;&#9;&#9;timer:startTimer(8, ms) -- TimerId..ms&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;if block == 2 then&#9;&#13;&#10;&#9;&#9;&#9;timer:setCallback(9, TimerCallback) -- TimerId &#13;&#10;&#9;&#9;&#9;timer:startTimer(9, ms) -- TimerId..ms&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;if block == 3 then&#9;&#13;&#10;&#9;&#9;&#9;timer:setCallback(10, TimerCallback) -- TimerId &#13;&#10;&#9;&#9;&#9;timer:startTimer(10, ms) -- TimerId..ms&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;if block == 4 then&#9;&#13;&#10;&#9;&#9;&#9;timer:setCallback(11, TimerCallback) -- TimerId &#13;&#10;&#9;&#9;&#9;timer:startTimer(11, ms) -- TimerId..ms&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;if block == 5 then&#9;&#13;&#10;&#9;&#9;&#9;timer:setCallback(12, TimerCallback) -- TimerId &#13;&#10;&#9;&#9;&#9;timer:startTimer(12, ms) -- TimerId..ms&#13;&#10;&#9;&#9;end&#13;&#10;&#9;end&#13;&#10;end"
                   luaMethodLinkedProperty="" luaMethodSource="0" uuid="d165def5f72e4ba3918bb1d25653762e"
                   luaMethodValid="1"/>
      </luaMethodGroup>
      <luaMethodGroup name="teststuff" uuid="5fdd71bf44054e53b6d5eb9c8b3760b9">
        <luaMethod luaMethodName="jonasTest" luaMethodCode="jonasTest = function()&#13;&#10;-- hilfsfunktionen:&#13;&#10;splitHexStringIntoByteStringArray = function(str)&#13;&#10;&#9;local singleBytes = {} -- leere liste, hier kommen einfach die hex-werte rein&#13;&#10;&#9;for i in string.gmatch(str, &quot;%w+&quot;) do -- bei leerzeichen trennen (matchen auf alles, das kein leerzeichen ist)&#13;&#10;&#9;&#9;table.insert(singleBytes, i) -- die einzelnen bytes zur liste hinzuf&#252;gen&#13;&#10;&#9;end&#13;&#10;&#9;return singleBytes&#13;&#10;end&#13;&#10;&#13;&#10;reverseTable = function(tab) -- reihenfolge umkehren&#13;&#10;&#9;tab2 = {}&#13;&#10;&#9;for i=1, #tab do&#13;&#10;&#9;&#9;table.insert(tab2, tab[#tab + 1 - i])&#13;&#10;&#9;end&#13;&#10;&#9;return tab2&#13;&#10;end&#13;&#10;&#13;&#10;prependZeros = function(tabOfNibbles) -- nullen voranstellen&#13;&#10;&#9;tab = {}&#13;&#10;&#9;for i, nibble in ipairs(tabOfNibbles) do&#13;&#10;&#9;&#9;table.insert(tab, string.format(&quot;0%s&quot;, nibble))&#13;&#10;&#9;end&#13;&#10;&#9;return tab&#13;&#10;end&#13;&#10;&#13;&#10;hexToDec = function(hex)&#13;&#10;&#9;return tonumber(hex, 16) -- 16 bedeutet wohl hex&#13;&#10;&#9;end&#13;&#10;end"
                   luaMethodLinkedProperty="" luaMethodSource="0" uuid="93b3ee5c0daa4edb9ef1316008837fbd"
                   luaMethodValid="1"/>
        <luaMethod luaMethodName="snd16BitTester" luaMethodCode="snd16BitTester = function(--[[ CtrlrModulator --]] mod, --[[ number --]] value, --[[ number --]] source)&#10;&#13;&#10;  &#9;if is_panel_ready() == true then&#13;&#10;&#9;&#9;local DevCode = string.format('F0 4C 0%.1x 15 01', MidiChannel)&#13;&#10;&#9;&#9;--local w = tonumber(mod:getProperty(&quot;modulatorCustomIndexGroup&quot;))&#13;&#10;&#9;&#9;local v = string.format(&quot;%.2x&quot;, (tonumber(mod:getProperty(&quot;modulatorCustomIndexGroup&quot;))))&#13;&#10;&#9;&#9;local w = string.format(&quot;%.2x&quot;, (tonumber(mod:getProperty(&quot;modulatorCustomIndex&quot;))))&#13;&#10;&#9;&#9;local paramValue_1 = '70'&#13;&#10;&#9;&#9;local x = tonumber(mod:getValueMapped())&#13;&#10;&#13;&#10;&#9;&#9;local message = table.concat({DevCode, paramValue_1, w, nibbles2or4(x, 16), 'F7'}, ' ')&#13;&#10;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(message))&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;"
                   luaMethodLinkedProperty="" luaMethodSource="0" uuid="e6f67ac7ace34e81a5e70062edafcb08"
                   luaMethodValid="1"/>
        <luaMethod luaMethodName="snd8BitTester" luaMethodCode="snd8BitTester = function(--[[ CtrlrModulator --]] mod, --[[ number --]] value, --[[ number --]] source)&#10;&#13;&#10;&#9;if is_panel_ready() == true then&#13;&#10;&#9;&#9;local DevCode = string.format('F0 4C 0%.1x 15 01', MidiChannel) &#13;&#10;&#9;&#9;local v = string.format(&quot;%.2x&quot;, (tonumber(mod:getProperty(&quot;modulatorCustomIndexGroup&quot;))))&#13;&#10;&#9;&#9;local w = string.format(&quot;%.2x&quot;, (tonumber(mod:getProperty(&quot;modulatorCustomIndex&quot;))))&#13;&#10;&#9;&#9;local paramValue_1 = '11'&#13;&#10;&#9;&#9;local x = tonumber(mod:getValueMapped())&#13;&#10;&#13;&#10;&#9;&#9;local message = table.concat({DevCode, paramValue_1, nibbles2or4(x, 8), 'F7'}, ' ')-- v, w, &#13;&#10;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(message))&#13;&#10;&#9;end&#13;&#10;end"
