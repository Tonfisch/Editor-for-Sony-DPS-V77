        <luaMethod luaMethodName="assignSpecialFader" luaMethodCode="function assignSpecialFader(Time, TimeFine, Disp, paraTyp, FxPara)&#13;&#10;&#13;&#10;--assignSpecialFader(FxASpec6, FxASpec6Fine, FxASpec6Disp, AlgoTables[76][6], 200) &#9;&#9;&#9;&#9;&#9;for testing&#13;&#10;&#10;&#13;&#10;&#9;&#9;local y = tostring(FxPara, &quot;%W&quot;)&#9;&#9;&#9;--substring did not work with numbers...&#13;&#10;&#9;&#9;local x = FxPara&#9;&#9;&#9;&#9;&#9;&#9;&#9;--number-(value) also needed&#13;&#10;&#9;&#9;local var1 = 0&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;--reset var1, for later fillup&#13;&#10;&#9;&#9;local var2 = string.sub(y, -1)*1&#9;&#9;&#9;--get the last digit for the Fine-Fader&#13;&#10;&#9;&#9;local var3 = 0&#13;&#10;&#9;&#9;local var5 = 0&#13;&#10;&#9;&#9;local var6 = 0&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#13;&#10;&#9;&#9;local a = y -36&#13;&#10;&#9;&#9;local LabelValue = ''&#13;&#10;&#9;&#9;local z = string.sub(a, - 2)&#9;&#13;&#10;&#13;&#10;&#13;&#10;&#9;&#9;if x &lt;= 64536  and x &gt;= 40000 then&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;--&#9;-1000&#9;-&#9;~-25000&#13;&#10;&#9;&#9;&#9;LabelValue = (65536-x)*-1&#13;&#10;&#9;&#9;&#9;Disp:getComponent():setPropertyString (&quot;uiLabelText&quot;, LabelValue..'')&#13;&#10;&#9;&#9;&#9;&#9;if z == &quot;00&quot; then&#13;&#10;&#9;&#9;&#9;&#9;&#9;var1 = (string.sub(a, 1, 3)*100)+36&#13;&#10;&#9;&#9;&#9;&#9;&#9;var2 = 0&#13;&#10;&#9;&#9;&#9;&#9;&#9;Time:setValueMapped(var1, false, false)&#13;&#10;&#9;&#9;&#9;&#9;&#9;TimeFine:setValueMapped(var2,  false, false)&#13;&#10;&#9;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;&#9;if z ~= &quot;00&quot; then&#13;&#10;&#9;&#9;&#9;&#9;&#9;var1 = (string.sub(a, 1, 3)*100)+136&#13;&#10;&#9;&#9;&#9;&#9;&#9;var2 = (100-z)*-1&#13;&#10;&#9;&#9;&#9;&#9;&#9;Time:setValueMapped(var1, false, false)&#13;&#10;&#9;&#9;&#9;&#9;&#9;TimeFine:setValueMapped(var2,  false, false)&#13;&#10;&#9;&#9;&#9;&#9;end&#13;&#10;&#13;&#10;&#9;&#9;elseif x &lt;= 65436  and x &gt;= 64536-1 then&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;--&#9;-100&#9;-&#9;-999&#13;&#10;&#9;&#9;&#9;LabelValue = (65536-x)*-1&#13;&#10;&#9;&#9;&#9;Disp:getComponent():setPropertyString (&quot;uiLabelText&quot;, LabelValue..'')&#13;&#10;&#9;&#9;&#9;var1 = (string.sub(a, 1, 3)*100)+136&#13;&#10;&#9;&#9;&#9;var2 = (100-z)*-1&#13;&#10;&#13;&#10;&#9;&#9;&#9;&#9;if z == &quot;00&quot; then&#13;&#10;&#9;&#9;&#9;&#9;&#9;var1 = (string.sub(a, 1, 3)*100)+36&#13;&#10;&#9;&#9;&#9;&#9;&#9;var2 = 0&#13;&#10;&#9;&#9;&#9;&#9;&#9;Time:setValueMapped(var1, false, false)&#13;&#10;&#9;&#9;&#9;&#9;&#9;TimeFine:setValueMapped(var2,  false, false)&#13;&#10;&#9;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;&#9;if z ~= &quot;00&quot; then&#13;&#10;&#9;&#9;&#9;&#9;&#9;var1 = (string.sub(a, 1, 3)*100)+136&#13;&#10;&#9;&#9;&#9;&#9;&#9;var2 = (100-z)*-1&#13;&#10;&#9;&#9;&#9;&#9;&#9;Time:setValueMapped(var1, false, false)&#13;&#10;&#9;&#9;&#9;&#9;&#9;TimeFine:setValueMapped(var2,  false, false)&#13;&#10;&#9;&#9;&#9;&#9;end&#13;&#10;&#13;&#10;&#9;&#13;&#10;&#9;&#9;elseif x &lt;= 65536  and x &gt;= 65436-1 then&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;--&#9;-1&#9;-&#9;-99&#13;&#10;&#9;&#9;&#9;LabelValue = (65536-x)*-1&#13;&#10;&#9;&#9;&#9;Disp:getComponent():setPropertyString (&quot;uiLabelText&quot;, LabelValue..'')&#13;&#10;&#9;&#9;&#9;var1 = 0&#13;&#10;&#9;&#9;&#9;var2 = (100-z)*-1&#13;&#10;&#13;&#10;&#9;&#9;&#9;Time:setValueMapped(var1, false, false)&#13;&#10;&#9;&#9;&#9;TimeFine:setValueMapped(var2,  false, false)&#13;&#10;&#13;&#10;&#9;&#9;elseif x &lt;= 10000 and x &gt;= 1000 then&#13;&#10;&#9;&#9;&#9;LabelValue = x&#13;&#10;&#9;&#9;&#9;Disp:getComponent():setPropertyString (&quot;uiLabelText&quot;, LabelValue..'')&#13;&#10;&#9;&#9;&#9;var1 = (string.sub(y, 1, 2))*100&#13;&#10;&#9;&#9;&#9;var2 = string.sub(y, -2)*1&#13;&#10;&#9;&#9;&#9;Time:setValueMapped(var1, false, false)&#13;&#10;&#9;&#9;&#9;TimeFine:setValueMapped(var2,  false, false)&#13;&#10;&#13;&#10;&#9;&#9;elseif x &lt;= 1000-1 and x &gt;= 100 then&#13;&#10;&#9;&#9;&#9;LabelValue = x&#13;&#10;&#9;&#9;&#9;Disp:getComponent():setPropertyString (&quot;uiLabelText&quot;, LabelValue..'')&#13;&#10;&#9;&#9;&#9;var1 = string.sub(y, 1, 1)*100&#13;&#10;&#9;&#9;&#9;var2 = string.sub(y, -2)*1&#13;&#10;&#9;&#9;&#9;Time:setValueMapped(var1, false, false)&#13;&#10;&#9;&#9;&#9;TimeFine:setValueMapped(var2,  false, false)&#13;&#10;&#13;&#10;&#9;&#9;elseif x &lt;= 100-1 then&#13;&#10;&#9;&#9;&#9;LabelValue = x&#13;&#10;&#9;&#9;&#9;Disp:getComponent():setPropertyString (&quot;uiLabelText&quot;, LabelValue..'')&#13;&#10;&#9;&#9;&#9;var1 = 0&#13;&#10;&#9;&#9;&#9;var2 = string.sub(y, -2)*1&#13;&#10;&#9;&#9;&#9;Time:setValueMapped(0, false, false)&#13;&#10;&#9;&#9;&#9;TimeFine:setValueMapped(var2,  false, false)&#13;&#10;&#13;&#10;&#9;&#9;else end&#13;&#10;&#13;&#10;&#9;&#9;Time:getComponent():setProperty(&quot;uiFixedSliderContent&quot;, slidercontent[paraTyp[&quot;SubTypeIndex&quot;]], false)&#13;&#10;&#9;&#9;Time:getComponent():setProperty(&quot;componentVisibleName&quot;, paraTyp[&quot;shortName&quot;], false)&#13;&#10;&#9;&#9;TimeFine:getComponent():setProperty(&quot;componentVisibleName&quot;, paraTyp[&quot;shortName&quot;]..&quot;Fine&quot;, false)&#13;&#10;&#9;&#9;Time:getComponent():setVisible(true)&#13;&#10;&#9;&#9;TimeFine:getComponent():setVisible(true)&#13;&#10;&#9;&#9;Disp:getComponent():setVisible(true)&#13;&#10;end"
                   luaMethodLinkedProperty="" luaMethodSource="0" uuid="dc4ac4ae1adc44ec9bc3c27f4d3f6890"
                   luaMethodValid="1"/>
