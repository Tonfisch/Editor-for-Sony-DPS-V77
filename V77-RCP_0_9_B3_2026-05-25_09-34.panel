      <luaMethodGroup name="timer" uuid="23420eef5e4743d2aa7108d2e27e9e3b">
        <luaMethod luaMethodName="TimerCallback" luaMethodCode="function TimerCallback(timerId)&#13;&#10;&#13;&#10;&#9;local DevCode = string.format('F0 4C 0%.1x 15 01', MidiChannel)&#13;&#10;--_______________________________________________________________________________________________________&#13;&#10;&#13;&#10;&#9;if timerId == 4 then&#9;&#9;&#9;&#9;&#9;--psetImportStartTimer&#13;&#10;&#13;&#10;&#9;&#9;timer:stopTimer(timerId)&#13;&#10;&#9;&#9;psetDumpRec = false&#13;&#10;&#9;&#9;Gt_Ps_Lst_Akt:setValueMapped(0, false, false)&#13;&#10;&#13;&#10;&#13;&#10;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(string.format(DevCode..' 10 0a 00 f7')))&#13;&#10;&#9;&#9;os.execute(sleep(100))&#13;&#10;&#9;&#9;panel:sendMidiMessageNow(CtrlrMidiMessage(string.format(DevCode..' 10 0a 00 f7')))&#13;&#10;&#9;&#9;os.execute(sleep(1000))&#13;&#10;&#9;&#9;assignPsetListBox(PsetLst_User1, 'PsetListBoxUser1')&#13;&#10;&#9;&#9;assignPsetListBox(PsetLst_User2, 'PsetListBoxUser2')&#13;&#10;&#9;end&#13;&#10;--_______________________________________________________________________________________________________&#13;&#10;&#13;&#10;&#9;if timerId == 5 then&#9;&#9;&#9;&#9;&#9;--fill presetlist&#13;&#10;&#13;&#10;&#13;&#10;&#9;&#9;timer:stopTimer(timerId)&#13;&#10;        PanelWatch:setValueMapped(0, false, false)&#13;&#10;&#9;&#9;assignPsetListBox(PsetList1, 'PsetListBox1')&#13;&#10;&#9;&#9;assignPsetListBox(PsetList2, 'PsetListBox2')&#13;&#10;&#9;&#9;assignPsetListBox(blankPlist, 'PsetListBoxUser1')&#13;&#10;&#9;&#9;assignPsetListBox(blankPlist, 'PsetListBoxUser2')&#13;&#10;&#9;&#9;allFadUnvis()&#13;&#10;--&#9;&#9;normFadVisible()&#13;&#10;&#9;&#9;deSelectListRows('PsetListBox1')&#13;&#10;&#9;&#9;deSelectListRows('PsetListBox2')&#13;&#10;&#9;&#9;deSelectListRows('PsetListBoxUser1')&#13;&#10;&#9;&#9;deSelectListRows('PsetListBoxUser2')&#13;&#10;        PanelWatch:setValueMapped(0, false, false)&#13;&#10;--&#9;&#9;allFadUnvis()&#13;&#10;&#9;&#9;normFadVisible()&#13;&#10;        PanelWatch: