      <luaMethodGroup name="Algorithm" uuid="59ea667a86ca4ed793587a975a864c2c">
        <luaMethod luaMethodName="gatherSingFadToLst" luaMethodCode="function gatherSingFadToLst(FadVal)&#13;&#10;&#10;&#9;local Key1 = FadVal:getRange(1,1):toHexString(1)&#13;&#10;&#9;local block = tonumber(Key1,16)&#13;&#10;&#9;local Key2 = FadVal:getRange(2,1):toHexString(1)&#13;&#10;&#9;local slotNr = tonumber(Key2,16)&#13;&#10;&#13;&#10;&#9;local val = combNib(FadVal:getRange(3,4), 16)&#13;&#10;&#13;&#10;&#9;if block == 1 then&#13;&#10;&#9;&#9;paraValEqA[slotNr][&quot;Val&quot;] = val&#13;&#10;&#9;&#9;EqAFaderUnvisible()&#13;&#10;&#9;&#9;if slotNr == 29 then&#13;&#10;&#9;&#9;&#9;reAssignEqAFader(paraValEqA)&#13;&#10;&#9;&#9;end&#13;&#10;&#9;end&#13;&#10;&#9;if block == 2 then&#13;&#10;&#9;&#9;paraValFxA[slotNr][&quot;Val&quot;] = val&#13;&#10;&#9;&#9;FxAFaderUnvisible()&#13;&#10;&#9;&#9;if slotNr == 29 then&#13;&#10;&#9;&#9;&#9;reAssignFxAFader(paraValFxA)&#13;&#10;&#9;&#9;end&#13;&#10;&#9;end&#13;&#10;&#9;if block == 3 then&#13;&#10;&#9;&#9;paraValEqB[slotNr][&quot;Val&quot;] = val&#13;&#10;&#9;&#9;EqBFaderUnvisible()&#13;&#10;&#9;&#9;if slotNr == 29 then&#13;&#10;&#9;&#9;&#9;reAssignEqBFader(paraValEqB)&#13;&#10;&#9;&#9;end&#13;&#10;&#9;end&#13;&#10;&#9;if block == 4 then&#13;&#10;&#9;&#9;paraValFxB[slotNr][&quot;Val&quot;] = val&#13;&#10;&#9;&#9;FxBFaderUnvisible()&#13;&#10;&#9;&#9;if slotNr == 29 then&#13;&#10;&#9;&#9;&#9;reAssignFxBFader(paraValFxB)&#13;&#10;&#9;&#9;end&#13;&#10;&#9;end&#13;&#10;&#9;if block == 5 then&#13;&#10;&#9;&#9;paraValMix[slotNr][&quot;Val&quot;] = val&#13;&#10;&#9;&#9;if slotNr == 29 then&#13;&#10;&#9;&#9;&#9;reAssignMixFader(paraValMix)&#13;&#10;&#9;&#9;end&#13;&#10;&#9;end&#13;&#10;end"
                   luaMethodLinkedProperty="" luaMethodSource="0" uuid="10639b3fe6744b37b26c0724aac50cde"
                   luaMethodValid="1"/>
      </luaMethodGroup>
